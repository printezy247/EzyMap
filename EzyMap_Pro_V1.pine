// New — Session / Time-of-Day filter.
// Blocks LIVE promotion outside your chosen trading window. Session string
// syntax also supports day-of-week codes (1=Sun...7=Sat), so the default
// below is already Mon-Fri only, London+NY hours in UTC.
bool useSessionFilter=input.bool(true,"Use Trading Session Filter",group=G7,display=display.none)
string tradingSessionWindow=input.session("0700-2000:23456","Trading Session Window",group=G7,display=display.none)
string sessionFilterTimezone=input.string("Etc/UTC","Trading Session Timezone",group=G7,display=display.none)

// New — Volatility Regime filter.
// Blocks LIVE promotion when current chart ATR has drifted too far from its
// own recent baseline — too low usually means dead/choppy conditions with
// low-conviction breakouts, too high usually means a news spike or gap.
bool useVolatilityFilter=input.bool(true,"Use Volatility Regime Filter",group=G7,display=display.none)
int volBaselineLength=input.int(100,"Volatility Baseline Length",minval=20,maxval=300,group=G7,display=display.none)
float volMinRatio=input.float(0.60,"Volatility Minimum (x Baseline)",minval=0.10,maxval=1.00,step=0.05,group=G7,display=display.none)
float volMaxRatio=input.float(1.80,"Volatility Maximum (x Baseline)",minval=1.00,maxval=4.00,step=0.10,group=G7,display=display.none)

// New — Signal Cooldown After a Loss on the Same Zone.
// After a genuine SL HIT, blocks LIVE promotion of any new setup whose
// support zone overlaps the zone that just lost, same direction, until the
// cooldown window elapses. Does not affect READY arming or chart drawing —
// only the LIVE commit.
bool useLossCooldown=input.bool(true,"Use Same-Zone Loss Cooldown",group=G7,display=display.none)
int lossCooldownMinutes=input.int(60,"Loss Cooldown (Minutes)",minval=5,maxval=720,group=G7,display=display.none)

// New — Trade Management Beyond Entry Filtering.
// Once the break-even threshold is reached, instead of only guaranteeing a
// flat return-to-entry exit, the stop trails behind price by an ATR
// multiple so winners that keep running are not capped at breakeven. The
// exit is still labelled BE HIT (same Telegram wording/parsing as before),
// but the pips result now reflects whatever the trail actually locked in —
// 0 if price never advanced past the trigger, positive if it did.
bool useTrailingAfterBE=input.bool(true,"Trail Stop After Break-Even",group=G8,display=display.none)
float trailAfterBEAtrMult=input.float(1.00,"Trail Distance (x Chart ATR)",minval=0.20,maxval=3.00,step=0.10,group=G8,display=display.none)

