//@version=6
indicator("EzyMap Pro V1", shorttitle="EzyMap Pro", overlay=true, max_bars_back=5000, max_lines_count=30, max_boxes_count=20, max_labels_count=180, dynamic_requests=true)

//==================================================================================================
// EZYMAP PRO V1
// Built directly on v4.7.0 — same READY/LIVE mapping, same touch mechanism
// (bar-range overlap + touch latch, committed on the confirmed candle close),
// same TP/SL/BE and trailing-after-BE, same session/volatility/cooldown
// filters (G7/G8), all unchanged. Five specific changes on top:
//
// 1) BUY and SELL can be independently READY at the same time instead of one
//    exclusive slot picking a winner. Trend-following still uses the near
//    HIGH RISK zone (S1 for BUY, R1 for SELL), exactly as v4.7.0 always did.
//    Counter-trend now uses the far LOW RISK zone (S2 / R2) instead of
//    sharing the trend zone. Whichever side CMP touches first releases LIVE.
// 2) Confluence count is no longer a pass/fail gate anywhere — not for READY
//    arming, not for the LIVE release. CMP touching an armed zone (with a
//    valid confirmation event and a valid TP/SL plan, exactly as v4.7.0
//    already required) is enough on its own.
// 3) Confluence is still calculated exactly as before and still drives the
//    trade card's CONFIDENCE label — it's informational now, not a filter.
// 4) TP, SL, BE and the trailing-after-BE stop are unchanged from v4.7.0.
// 5) Only one trade can be ACTIVE. A direction cannot re-arm a fresh READY
//    zone while its own trade is the one currently active. The opposite
//    direction's already-armed zone keeps existing and updates with the map
//    exactly as v4.7.0 always did (resync/invalidate on real structure
//    changes) — it simply cannot commit to ACTIVE until the current trade
//    hits TP, SL or BE.
//
// Everything else — CHOCH/rejection/sweep/displacement confirmation, the
// counter-trend reversal-quality requirement (completed sweep/reclaim or
// displacement CHOCH), EMA regime, VWAP, MTF clustering, the 33-marker
// ledger — is v4.7.0, unchanged.
//==================================================================================================

//--------------------------------------------------------------------------------------------------
// Inputs
//--------------------------------------------------------------------------------------------------
const string G1="01 • Engine"
const string G2="02 • Confirmation"
const string G3="03 • Risk"
const string G4="04 • Display"
const string G5="05 • Alerts"
const string G6="06 • Premium Theme"
const string G7="07 • Live Signal Filter"
const string G8="08 • Trade Management"

string chartTfSelection=input.string("AUTO","Chart Timeframe",options=["AUTO","1","5","15","30","60","240"],group=G1,display=display.none)
const int directionEmaLength=13
int supportPivotBars=input.int(3,"Supporting Swing Bars",minval=2,maxval=8,group=G1,display=display.none)
float levelDistinctPips=input.float(10.0,"Minimum Level Separation",minval=1.0,maxval=100.0,step=1.0,group=G1,display=display.none)

int entryPivotBars=input.int(1,"Entry CHoCH Swing Bars",minval=1,maxval=5,group=G2,display=display.none)
bool requireDirectionalBody=input.bool(false,"Require Directional Confirmation Body",group=G2,display=display.none)
float rejectionWickRatio=input.float(0.25,"Rejection Wick / Body Ratio",minval=0.20,maxval=3.0,step=0.05,group=G2,display=display.none)
// Pro V1: confluence count no longer gates arming or LIVE release (see the
// header block) — it is calculated and shown on the trade card as CONFIDENCE
// only, so the old trend/counter-trend minimum-confluence thresholds are gone.
int armedExpiryEntryBars=input.int(60,"READY Expiry (Entry bars)",minval=3,maxval=60,group=G2,display=display.none)
float confluenceTolerancePips=input.float(70.0,"Confluence Tolerance",minval=5.0,maxval=200.0,step=5.0,group=G2,display=display.none)
bool useMtfLevelCluster=input.bool(true,"Use Multi-Timeframe Level Cluster",group=G2,display=display.none)
bool useSweepReclaim=input.bool(true,"Use Completed Liquidity Sweep + Reclaim",group=G2,display=display.none)
int sweepLookbackBars=input.int(5,"Liquidity Sweep Lookback",minval=2,maxval=12,group=G2,display=display.none)

// Premium additions. All are additive quality evidence; none is a global hard filter.
bool useSessionDayLiquidity=input.bool(true,"Use Session / Previous-Day Sweep + Reclaim",group=G2,display=display.none)
string liquidityTimezone=input.string("Etc/UTC","Liquidity Session Timezone",group=G2,display=display.none)
string asiaSession=input.session("0000-0800","Asian Session",group=G2,display=display.none)
