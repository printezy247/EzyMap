bool useEmaRegime=input.bool(true,"Use EMA13 Slope + EMA50 Regime",group=G2,display=display.none)
const int regimeEmaLength=50
float emaSlopeMinATR=input.float(0.01,"Minimum EMA13 Slope / ATR",minval=0.0,maxval=0.20,step=0.005,group=G2,display=display.none)

bool useDisplacementChoch=input.bool(true,"Use Displacement-Quality CHoCH",group=G2,display=display.none)
