float intradayTargetMaxPoints=input.float(250.0,"Intraday Target Maximum",minval=100.0,maxval=1500.0,step=50.0,group=G3,display=display.none)
float swingTargetMinPoints=input.float(180.0,"Swing Target Minimum",minval=100.0,maxval=2000.0,step=20.0,group=G3,display=display.none)
float swingTargetMaxPoints=input.float(800.0,"Swing Target Maximum",minval=300.0,maxval=5000.0,step=100.0,group=G3,display=display.none)
float minimumRR=input.float(0.6,"Minimum R:R",minval=0.5,maxval=1.0,step=0.1,group=G3,display=display.none)
float maximumRR=input.float(2.5,"Maximum R:R",minval=2.5,maxval=2.5,group=G3,display=display.none)
float snrFrontRunPips=input.float(10.0,"TP / SL Before S&R",minval=5.0,maxval=100.0,step=5.0,group=G3,display=display.none)
bool useBreakEven=input.bool(true,"Use Break-Even Protection",group=G3,display=display.none)
float breakEvenM15TriggerPips=input.float(25.0,"M15 Break-Even Activation",minval=1.0,maxval=300.0,step=1.0,group=G3,display=display.none)
bool showDirectionLevels=input.bool(true,"Show Direction S&R",group=G4,display=display.none)
bool showSupportingZones=input.bool(true,"Show Supporting Zones",group=G4,display=display.none)
bool showEntryZone=input.bool(true,"Show Entry Zone",group=G4,display=display.none)
int resultVisibleSeconds=input.int(30,"Result Visible Seconds",minval=5,maxval=3600,group=G4,display=display.none)
bool showDashboard=input.bool(true,"Show Dashboard",group=G4,display=display.none)
bool showTradeCard=input.bool(true,"Show Trade Card",group=G4,display=display.none)
bool showMarkers=input.bool(true,"Show Alert-Synced Markers",group=G4,display=display.none)
bool showBacktestMarkers=input.bool(true,"Show Historical Markers (No Alerts)",group=G4,display=display.none)
const int MAX_HISTORICAL_MARKERS=33
const int MAXIMUM_ZONE_RETESTS=4

bool enableAlerts=input.bool(true,"Enable Alerts",group=G5,display=display.none)
bool alertLive=input.bool(true,"Alert LIVE",group=G5,display=display.none)
bool alertResult=input.bool(true,"Alert TP / SL / BE",group=G5,display=display.none)

// V1.2: the Session/Time-of-Day filter, Volatility Regime filter and
// Same-Zone Loss Cooldown (previously G7) are removed entirely — they
// existed purely to block LIVE promotion, which fights trade frequency.

// New — Trade Management Beyond Entry Filtering.
// Once the break-even threshold is reached, instead of only guaranteeing a
// flat return-to-entry exit, the stop trails behind price by an ATR
// multiple so winners that keep running are not capped at breakeven. The
// exit is still labelled BE HIT (same Telegram wording/parsing as before),
// but the pips result now reflects whatever the trail actually locked in —
// 0 if price never advanced past the trigger, positive if it did.
bool useTrailingAfterBE=input.bool(true,"Trail Stop After Break-Even",group=G8,display=display.none)
float trailAfterBEAtrMult=input.float(1.00,"Trail Distance (x Chart ATR)",minval=0.20,maxval=3.00,step=0.10,group=G8,display=display.none)

color buyColor=input.color(color.rgb(0,208,142),"BUY",inline="A",group=G6,display=display.none)
color sellColor=input.color(color.rgb(235,72,96),"SELL",inline="A",group=G6,display=display.none)
color supportColor=input.color(color.rgb(52,211,176),"Support",inline="B",group=G6,display=display.none)
color resistanceColor=input.color(color.rgb(237,185,58),"Resistance",inline="B",group=G6,display=display.none)
color panelColor=input.color(color.rgb(7,10,14),"Panel",inline="C",group=G6,display=display.none)
color headerColor=input.color(color.rgb(20,26,33),"Header",inline="C",group=G6,display=display.none)
color neutralColor=input.color(color.rgb(204,211,218),"Neutral",inline="D",group=G6,display=display.none)
color warningColor=input.color(color.rgb(240,158,38),"Warning",inline="D",group=G6,display=display.none)

color premiumFrameColor=color.rgb(66,75,86)
color premiumTextColor=color.rgb(239,243,247)

//--------------------------------------------------------------------------------------------------
// v4.5.11 stable historical-marker guarantees
//--------------------------------------------------------------------------------------------------
// • v4.5.2 timeframe routing, map drawings, zone sizes, TP/SL, dashboard and alerts are preserved.
// • The proven v4.5.2 drawing, READY/LIVE, marker, dashboard and timeframe-routing behavior is preserved.
// • Previous-day / Asian / London sweep-reclaim, EMA13 slope + EMA50 regime,
//   displacement CHOCH and daily VWAP are additive quality evidence.
// • Premium liquidity reclaim and displacement CHOCH can also provide fresh confirmation,
//   increasing opportunities without making all five additions compulsory.
// • Counter-trend setups require completed sweep-reclaim or displacement-quality CHOCH.
// • Historical markers remain timestamp-anchored to avoid TradingView's 10,000-bar limit.
// • Break-even arms after the timeframe-scaled favorable move and exits at entry on a later reclaim.
// • READY, ACTIVE, TP, SL and BE alerts use the EZYMAP • SCALP MASTERY templates.
// • LIVE is committed only on the completed chart candle; chart and alert use the same snapshot.
// • Realtime LIVE markers are stored only after the matching alert() call executes.
// • Historical markers are reconstructed independently and never generate alerts.
// • A single permanent ledger keeps the newest 33 BUY/SELL markers stable.
// • Marker labels are created once and are not deleted/rebuilt on every live tick.
// • Historical bars never update alert deduplication keys.
// • The engine resets simulated historical trade state before realtime monitoring begins.
//--------------------------------------------------------------------------------------------------
// Pro V1 additions on top of all of the above (see the header block):
// dual independent BUY/SELL READY slots, LOW RISK zone for counter-trend,
// and confluence count no longer gates arming or LIVE release — it is
// display-only (the CONFIDENCE field). Every guarantee above still holds.
//--------------------------------------------------------------------------------------------------

//--------------------------------------------------------------------------------------------------
// Timeframe routing
//--------------------------------------------------------------------------------------------------
float chartSeconds=timeframe.in_seconds()
bool supportedChartTf=chartSeconds==60.0 or chartSeconds==300.0 or chartSeconds==900.0 or chartSeconds==1800.0 or chartSeconds==3600.0 or chartSeconds==14400.0
string actualChartTf=chartSeconds==60.0?"1":chartSeconds==300.0?"5":chartSeconds==900.0?"15":chartSeconds==1800.0?"30":chartSeconds==3600.0?"60":chartSeconds==14400.0?"240":"15"

// AUTO follows the actual chart. Manual selection remains available, but the
// chart must match the selected chart timeframe for signal processing.
string selectedChartTf=chartTfSelection=="AUTO"?actualChartTf:chartTfSelection
string mode=selectedChartTf=="1" or selectedChartTf=="5"?"SCALP":selectedChartTf=="15" or selectedChartTf=="30"?"INTRADAY":"SWING"

// Exact routing matrix:
// M1  -> M30 direction / M5 support / M1 entry
// M5  -> H1 direction / M15 support / M5 entry
// M15 -> H4 direction / M30 support / M15 entry
// M30 -> Daily direction / H1 support / M30 entry
// H1  -> Weekly direction / H4 support / H1 entry
// H4  -> Monthly direction / Daily support / H4 entry
string directionTf=selectedChartTf=="1"?"30":selectedChartTf=="5"?"60":selectedChartTf=="15"?"240":selectedChartTf=="30"?"D":selectedChartTf=="60"?"W":"M"
string supportTf=selectedChartTf=="1"?"5":selectedChartTf=="5"?"15":selectedChartTf=="15"?"30":selectedChartTf=="30"?"60":selectedChartTf=="60"?"240":"D"
string entryTf=selectedChartTf

string entryTfLabel=entryTf=="1"?"M1":entryTf=="5"?"M5":entryTf=="15"?"M15":entryTf=="30"?"M30":entryTf=="60"?"H1":"H4"

float selectedChartSeconds=selectedChartTf=="1"?60.0:selectedChartTf=="5"?300.0:selectedChartTf=="15"?900.0:selectedChartTf=="30"?1800.0:selectedChartTf=="60"?3600.0:14400.0
float supportSeconds=supportTf=="5"?300.0:supportTf=="15"?900.0:supportTf=="30"?1800.0:supportTf=="60"?3600.0:supportTf=="240"?14400.0:86400.0
float entrySeconds=entryTf=="1"?60.0:entryTf=="5"?300.0:entryTf=="15"?900.0:entryTf=="30"?1800.0:entryTf=="60"?3600.0:14400.0
bool chartMatchesSelected=supportedChartTf and chartSeconds==selectedChartSeconds

//--------------------------------------------------------------------------------------------------
// Helpers
//--------------------------------------------------------------------------------------------------
f_price(float value)=>na(value)?"—":str.tostring(value,format.mintick)
f_zone(float lo,float hi)=>na(lo) or na(hi)?"—":f_price(lo)+" – "+f_price(hi)
f_overlap(float lo,float hi,float zoneLo,float zoneHi)=>not na(lo) and not na(hi) and not na(zoneLo) and not na(zoneHi) and hi>=zoneLo and lo<=zoneHi

f_confidence_label(int confluences)=>
    confluences>=7?"QUALITY":confluences>=4?"GOOD":"STANDARD"

// First-touch proxy for historical bars and live ticks.
// Open inside zone -> open.
// Approach from above -> upper edge.
// Approach from below -> lower edge.
// Live price inside zone -> current live price.
f_touch_entry(float zoneLo,float zoneHi,float previousClose,float barOpen,float livePrice)=>
    float result=na
    if barOpen>=zoneLo and barOpen<=zoneHi
        result:=barOpen
    else if livePrice>=zoneLo and livePrice<=zoneHi
        result:=livePrice
    else if previousClose>zoneHi
        result:=zoneHi
    else if previousClose<zoneLo
        result:=zoneLo
    else
        result:=math.min(math.max(livePrice,zoneLo),zoneHi)
    math.round_to_mintick(result)
f_near(float a,float b,float tolerance)=>not na(a) and not na(b) and math.abs(a-b)<=tolerance
f_clamp(float value,float minimum,float maximum)=>math.max(minimum,math.min(maximum,value))
f_signed(float value)=>na(value)?"—":(value>0?"+":"")+str.tostring(int(math.round(value)))+" PIPS"

f_project(float newestValue,float olderValue,float newestBar,float olderBar,float currentBar)=>
    bool valid=not na(newestValue) and not na(olderValue) and not na(newestBar) and not na(olderBar) and newestBar!=olderBar
    valid?newestValue+(newestValue-olderValue)/(newestBar-olderBar)*(currentBar-newestBar):na

f_near_round(float value,float step,float tolerance)=>
    if na(value) or step<=0
        false
    else
        float nearest=math.round(value/step)*step
        math.abs(value-nearest)<=tolerance

