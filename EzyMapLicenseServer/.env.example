# Copy this file to .env and change these before deploying publicly.
PORT=3000

# Shared secret that unlocks the /admin/* routes (grant/revoke/list).
# Required on the DEPLOYED server for admin.js to be able to manage it
# remotely. Pick something long and random - anyone with this token can
# grant themselves a free subscription.
ADMIN_TOKEN=change_this_to_something_random

# --- admin.js REMOTE MODE (leave blank for local testing) ---
# Set this to your deployed server's URL to make admin.js manage THAT
# server instead of the local data/subscriptions.json file. ADMIN_TOKEN
# above must match the token set on the deployed server.
EZYMAP_SERVER_URL=
