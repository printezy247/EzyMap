//--------------------------------------------------------------------------------------------------
// v4.5.11 stable historical-marker guarantees
//--------------------------------------------------------------------------------------------------
// • v4.5.2 timeframe routing, map drawings, zone sizes, TP/SL, dashboard and alerts are preserved.
// • The proven v4.5.2 drawing, READY/LIVE, marker, dashboard and timeframe-routing behavior is preserved.
// • Previous-day / Asian / London sweep-reclaim, EMA13 slope + EMA50 regime,
//   displacement CHOCH and daily VWAP are additive quality evidence.
// • Premium liquidity reclaim and displacement CHOCH can also provide fresh confirmation,
//   increasing opportunities without making all five additions compulsory.
// • Counter-trend setups require completed sweep-reclaim or displacement-quality CHOCH.
// • Historical markers remain timestamp-anchored to avoid TradingView's 10,000-bar limit.
// • Break-even arms after the timeframe-scaled favorable move and exits at entry on a later reclaim.
// • READY, ACTIVE, TP, SL and BE alerts use the EZYMAP • SCALP MASTERY templates.
// • LIVE is committed only on the completed chart candle; chart and alert use the same snapshot.
// • Realtime LIVE markers are stored only after the matching alert() call executes.
// • Historical markers are reconstructed independently and never generate alerts.
// • A single permanent ledger keeps the newest 33 BUY/SELL markers stable.
// • Marker labels are created once and are not deleted/rebuilt on every live tick.
// • Historical bars never update alert deduplication keys.
// • The engine resets simulated historical trade state before realtime monitoring begins.
//--------------------------------------------------------------------------------------------------

//--------------------------------------------------------------------------------------------------
// Timeframe routing
//--------------------------------------------------------------------------------------------------
float chartSeconds=timeframe.in_seconds()
bool supportedChartTf=chartSeconds==60.0 or chartSeconds==300.0 or chartSeconds==900.0 or chartSeconds==1800.0 or chartSeconds==3600.0 or chartSeconds==14400.0
string actualChartTf=chartSeconds==60.0?"1":chartSeconds==300.0?"5":chartSeconds==900.0?"15":chartSeconds==1800.0?"30":chartSeconds==3600.0?"60":chartSeconds==14400.0?"240":"15"

// AUTO follows the actual chart. Manual selection remains available, but the
// chart must match the selected chart timeframe for signal processing.
string selectedChartTf=chartTfSelection=="AUTO"?actualChartTf:chartTfSelection
string mode=selectedChartTf=="1" or selectedChartTf=="5"?"SCALP":selectedChartTf=="15" or selectedChartTf=="30"?"INTRADAY":"SWING"

// Exact routing matrix:
// M1  -> M30 direction / M5 support / M1 entry
// M5  -> H1 direction / M15 support / M5 entry
// M15 -> H4 direction / M30 support / M15 entry
// M30 -> Daily direction / H1 support / M30 entry
// H1  -> Weekly direction / H4 support / H1 entry
// H4  -> Monthly direction / Daily support / H4 entry
string directionTf=selectedChartTf=="1"?"30":selectedChartTf=="5"?"60":selectedChartTf=="15"?"240":selectedChartTf=="30"?"D":selectedChartTf=="60"?"W":"M"
string supportTf=selectedChartTf=="1"?"5":selectedChartTf=="5"?"15":selectedChartTf=="15"?"30":selectedChartTf=="30"?"60":selectedChartTf=="60"?"240":"D"
string entryTf=selectedChartTf

string entryTfLabel=entryTf=="1"?"M1":entryTf=="5"?"M5":entryTf=="15"?"M15":entryTf=="30"?"M30":entryTf=="60"?"H1":"H4"

float selectedChartSeconds=selectedChartTf=="1"?60.0:selectedChartTf=="5"?300.0:selectedChartTf=="15"?900.0:selectedChartTf=="30"?1800.0:selectedChartTf=="60"?3600.0:14400.0
float supportSeconds=supportTf=="5"?300.0:supportTf=="15"?900.0:supportTf=="30"?1800.0:supportTf=="60"?3600.0:supportTf=="240"?14400.0:86400.0
float entrySeconds=entryTf=="1"?60.0:entryTf=="5"?300.0:entryTf=="15"?900.0:entryTf=="30"?1800.0:entryTf=="60"?3600.0:14400.0
bool chartMatchesSelected=supportedChartTf and chartSeconds==selectedChartSeconds

//--------------------------------------------------------------------------------------------------
// Helpers
//--------------------------------------------------------------------------------------------------
f_price(float value)=>na(value)?"—":str.tostring(value,format.mintick)
f_zone(float lo,float hi)=>na(lo) or na(hi)?"—":f_price(lo)+" – "+f_price(hi)
f_overlap(float lo,float hi,float zoneLo,float zoneHi)=>not na(lo) and not na(hi) and not na(zoneLo) and not na(zoneHi) and hi>=zoneLo and lo<=zoneHi

f_confidence_label(int confluences)=>
    confluences>=7?"QUALITY":confluences>=4?"GOOD":"STANDARD"

// First-touch proxy for historical bars and live ticks.
// Open inside zone -> open.
// Approach from above -> upper edge.
// Approach from below -> lower edge.
// Live price inside zone -> current live price.
f_touch_entry(float zoneLo,float zoneHi,float previousClose,float barOpen,float livePrice)=>
    float result=na
    if barOpen>=zoneLo and barOpen<=zoneHi
        result:=barOpen
    else if livePrice>=zoneLo and livePrice<=zoneHi
        result:=livePrice
    else if previousClose>zoneHi
        result:=zoneHi
    else if previousClose<zoneLo
        result:=zoneLo
    else
        result:=math.min(math.max(livePrice,zoneLo),zoneHi)
    math.round_to_mintick(result)
f_near(float a,float b,float tolerance)=>not na(a) and not na(b) and math.abs(a-b)<=tolerance
f_clamp(float value,float minimum,float maximum)=>math.max(minimum,math.min(maximum,value))
f_signed(float value)=>na(value)?"—":(value>0?"+":"")+str.tostring(int(math.round(value)))+" PIPS"

f_project(float newestValue,float olderValue,float newestBar,float olderBar,float currentBar)=>
    bool valid=not na(newestValue) and not na(olderValue) and not na(newestBar) and not na(olderBar) and newestBar!=olderBar
    valid?newestValue+(newestValue-olderValue)/(newestBar-olderBar)*(currentBar-newestBar):na

f_near_round(float value,float step,float tolerance)=>
    if na(value) or step<=0
        false
    else
        float nearest=math.round(value/step)*step
        math.abs(value-nearest)<=tolerance

f_direction_bank()=>
    [close[1],close[2],close[3],close[4],close[5],close[6],close[7],close[8],close[9],close[10],close[11],close[12],close[13],close[14],close[15],close[16],close[17],close[18],close[19],close[20],close[21],close[22],close[23],close[24],close[25],close[26],close[27],close[28],close[29],close[30],close[31],close[32],close[33],close[34],close[35],close[36],close[37],close[38],close[39],close[40],close[41],close[42],close[43],close[44],close[45],close[46],close[47],close[48],close[49],close[50],close[51],close[52],close[53],close[54],close[55],close[56],close[57],close[58],close[59],close[60],close[61],close[62],close[63],close[64]]

f_support_bank()=>
    [high[1],high[2],high[3],high[4],high[5],high[6],high[7],high[8],high[9],high[10],high[11],high[12],high[13],high[14],high[15],high[16],high[17],high[18],high[19],high[20],high[21],high[22],high[23],high[24],high[25],high[26],high[27],high[28],high[29],high[30],high[31],high[32],high[33],high[34],high[35],high[36],high[37],high[38],high[39],high[40],low[1],low[2],low[3],low[4],low[5],low[6],low[7],low[8],low[9],low[10],low[11],low[12],low[13],low[14],low[15],low[16],low[17],low[18],low[19],low[20],low[21],low[22],low[23],low[24],low[25],low[26],low[27],low[28],low[29],low[30],low[31],low[32],low[33],low[34],low[35],low[36],low[37],low[38],low[39],low[40],time[1],time[2],time[3],time[4],time[5],time[6],time[7],time[8],time[9],time[10],time[11],time[12],time[13],time[14],time[15],time[16],time[17],time[18],time[19],time[20],time[21],time[22],time[23],time[24],time[25],time[26],time[27],time[28],time[29],time[30],time[31],time[32],time[33],time[34],time[35],time[36],time[37],time[38],time[39],time[40]]

f_entry_bank()=>
    [open[1],open[2],high[1],high[2],high[3],high[4],high[5],high[6],high[7],high[8],high[9],high[10],high[11],high[12],high[13],high[14],high[15],high[16],high[17],high[18],high[19],high[20],high[21],high[22],high[23],high[24],low[1],low[2],low[3],low[4],low[5],low[6],low[7],low[8],low[9],low[10],low[11],low[12],low[13],low[14],low[15],low[16],low[17],low[18],low[19],low[20],low[21],low[22],low[23],low[24],close[1],close[2],time[1],time[2],time[3],time[4],time[5],time[6],time[7],time[8],time[9],time[10],time[11],time[12],time[13],time[14],time[15],time[16],time[17],time[18],time[19],time[20],time[21],time[22],time[23],time[24]]

f_support_metrics(int pivotBars,int emaLength)=>
    float pivotHigh=ta.pivothigh(high,pivotBars,pivotBars)
    float pivotLow=ta.pivotlow(low,pivotBars,pivotBars)
    float newestHigh=ta.valuewhen(not na(pivotHigh),pivotHigh,0)
    float olderHigh=ta.valuewhen(not na(pivotHigh),pivotHigh,1)
    float newestHighBar=ta.valuewhen(not na(pivotHigh),float(bar_index[pivotBars]),0)
    float olderHighBar=ta.valuewhen(not na(pivotHigh),float(bar_index[pivotBars]),1)
    float newestLow=ta.valuewhen(not na(pivotLow),pivotLow,0)
    float olderLow=ta.valuewhen(not na(pivotLow),pivotLow,1)
    float newestLowBar=ta.valuewhen(not na(pivotLow),float(bar_index[pivotBars]),0)
    float olderLowBar=ta.valuewhen(not na(pivotLow),float(bar_index[pivotBars]),1)
    float projectedResistance=f_project(newestHigh,olderHigh,newestHighBar,olderHighBar,float(bar_index))
    float projectedSupport=f_project(newestLow,olderLow,newestLowBar,olderLowBar,float(bar_index))
    [ta.ema(close,emaLength)[1],projectedSupport[1],projectedResistance[1],newestHigh[1],newestLow[1],ta.atr(14)[1]]

// S2 must be at least minimumDistance below S1.
// R2 must be at least minimumDistance above R1.
f_pick_direction_levels(array<float> closes,float reference,float minimumDistance,float fallbackLow,float fallbackHigh,float fallbackATR)=>
    float s1=na
    float s2=na
    float r1=na
    float r2=na
    float s1Distance=na
    float s2Distance=na
    float r1Distance=na
    float r2Distance=na

    for i=0 to array.size(closes)-1
        float level=array.get(closes,i)
        if not na(level) and level<reference
            float distance=reference-level
            if na(s1Distance) or distance<s1Distance
                s1:=level
                s1Distance:=distance
        if not na(level) and level>reference
            float distance=level-reference
            if na(r1Distance) or distance<r1Distance
                r1:=level
                r1Distance:=distance

    for i=0 to array.size(closes)-1
        float level=array.get(closes,i)
        if not na(level) and not na(s1) and level<=s1-minimumDistance
            float distance=s1-level
            if na(s2Distance) or distance<s2Distance
                s2:=level
                s2Distance:=distance
        if not na(level) and not na(r1) and level>=r1+minimumDistance
            float distance=level-r1
            if na(r2Distance) or distance<r2Distance
                r2:=level
                r2Distance:=distance

    float safeATR=math.max(nz(fallbackATR),minimumDistance*5.0)
    if na(s1)
        s1:=math.min(nz(fallbackLow,reference-safeATR),reference-minimumDistance)
    if na(r1)
        r1:=math.max(nz(fallbackHigh,reference+safeATR),reference+minimumDistance)
    if na(s2)
        s2:=math.min(nz(fallbackLow,s1-safeATR),s1-minimumDistance)
    if na(r2)
        r2:=math.max(nz(fallbackHigh,r1+safeATR),r1+minimumDistance)

    [math.round_to_mintick(s1),math.round_to_mintick(s2),math.round_to_mintick(r1),math.round_to_mintick(r2)]

f_support_zone(float level,array<float> highs,array<float> lows,array<int> times)=>
    float exactLo=na
    float exactHi=na
    int exactTime=na
    float nearestRange=na
    float nearestDistance=na
    int nearestTime=na

    for i=0 to array.size(highs)-1
        float candleHigh=array.get(highs,i)
        float candleLow=array.get(lows,i)
        int candleTime=array.get(times,i)
        bool valid=not na(candleHigh) and not na(candleLow) and candleHigh>candleLow

        if valid
            bool crosses=candleLow<=level and candleHigh>=level
            if crosses and na(exactLo)
                exactLo:=candleLow
                exactHi:=candleHigh
                exactTime:=candleTime

            float midpoint=(candleHigh+candleLow)/2.0
            float distance=math.abs(midpoint-level)
            if na(nearestDistance) or distance<nearestDistance
                nearestDistance:=distance
                nearestRange:=candleHigh-candleLow
                nearestTime:=candleTime

    float zoneLo=exactLo
    float zoneHi=exactHi
    int zoneTime=exactTime

    if na(zoneLo)
        float preservedRange=math.max(nz(nearestRange),syminfo.mintick*10.0)
        zoneLo:=level-preservedRange*0.5
        zoneHi:=level+preservedRange*0.5
        zoneTime:=nearestTime

    [math.round_to_mintick(zoneLo),math.round_to_mintick(zoneHi),zoneTime]

f_zone_retest_count(float zoneLo,float zoneHi,int zoneTime,int currentEntryTime,float zoneSeconds,array<float> highs,array<float> lows,array<int> times)=>
    int retests=0
    bool previousInside=false
    int zoneReadyTime=not na(zoneTime)?zoneTime+int(zoneSeconds*1000.0):na

    if not na(zoneLo) and not na(zoneHi) and not na(zoneReadyTime) and not na(currentEntryTime)
        // Oldest to newest: one continuous visit counts as one retest.
        for offset=0 to array.size(highs)-1
            int i=array.size(highs)-1-offset
            int candleTime=array.get(times,i)
            float candleHigh=array.get(highs,i)
            float candleLow=array.get(lows,i)
            bool eligible=not na(candleTime) and candleTime>=zoneReadyTime and candleTime<=currentEntryTime
            bool inside=eligible and f_overlap(candleLow,candleHigh,zoneLo,zoneHi)

            if eligible
                if inside and not previousInside
                    retests+=1
                previousInside:=inside

    retests

f_select_full_entry_candle(float zoneLo,float zoneHi,float cmp,bool isBuy,float sideBuffer,array<float> highs,array<float> lows,array<int> times)=>
    float selectedLo=na
    float selectedHi=na
    int selectedTime=na
    float bestDistance=na

    // Select one exact confirmed entry-timeframe candle.
    // The returned rectangle preserves the complete wick-to-wick HIGH and LOW,
    // and that complete candle must fit inside the exact drawn risk zone.
    for i=0 to array.size(highs)-1
        float candleHigh=array.get(highs,i)
        float candleLow=array.get(lows,i)
        int candleTime=array.get(times,i)

        bool valid=not na(candleHigh) and not na(candleLow) and candleHigh>candleLow

        // The complete candle rectangle must be inside the exact drawn
        // active HIGH RISK supporting zone.
        bool fullyInsideDrawnZone=valid and candleLow>=zoneLo and candleHigh<=zoneHi
        bool correctSide=isBuy?candleHigh<cmp-sideBuffer:candleLow>cmp+sideBuffer

        if fullyInsideDrawnZone and correctSide
            float distance=isBuy?cmp-candleHigh:candleLow-cmp

            // Arrays are newest first. Equal-distance ties keep the newest candle.
            if na(bestDistance) or distance<bestDistance
                selectedLo:=candleLow
                selectedHi:=candleHigh
                selectedTime:=candleTime
                bestDistance:=distance

    [math.round_to_mintick(selectedLo),math.round_to_mintick(selectedHi),selectedTime]

f_recent_extremes(array<float> highs,array<float> lows,int lookback)=>
    float recentHigh=na
    float recentLow=na
    int limit=math.min(array.size(highs)-1,math.max(1,lookback))

    // Index 0 is the latest confirmed entry-timeframe candle.
    // Start at 1 so the liquidity pool exists before the sweep candle.
    for i=1 to limit
        float candidateHigh=array.get(highs,i)
        float candidateLow=array.get(lows,i)
        recentHigh:=na(recentHigh)?candidateHigh:math.max(recentHigh,candidateHigh)
        recentLow:=na(recentLow)?candidateLow:math.min(recentLow,candidateLow)

    [recentHigh,recentLow]

f_mtf_cluster(float directionLevel,float zoneLo,float zoneHi,float supportA,float supportB,float supportC,float entryLevel,float tolerance)=>
    float midpoint=(zoneLo+zoneHi)/2.0
    bool supportVote=f_near(directionLevel,supportA,tolerance) or f_near(directionLevel,supportB,tolerance) or f_near(directionLevel,supportC,tolerance)
    bool entryVote=f_near(directionLevel,entryLevel,tolerance) or f_near(midpoint,entryLevel,tolerance)
    supportVote and entryVote

f_confluence_count(float zoneLo,float zoneHi,float level,float emaValue,float trendValue,float fib50,float fib618,float brnStep,float microStep,float tolerance,bool mtfCluster,bool sweepReclaim,bool premiumLiquidity,bool displacementChoch,bool emaSlope,bool emaRegime,bool vwapConfluence)=>
    float midpoint=(zoneLo+zoneHi)/2.0
    // The direction-timeframe S&R level is the base prerequisite.
    // Related evidence is category-capped so correlated indicators do not inflate the score.
    int count=1
    bool brn=f_near_round(midpoint,brnStep,tolerance)
    bool micro=not brn and f_near_round(midpoint,microStep,tolerance)
    bool ema=f_near(midpoint,emaValue,tolerance)
    bool trend=f_near(midpoint,trendValue,tolerance)
    bool fib=f_near(midpoint,fib50,tolerance) or f_near(midpoint,fib618,tolerance)

    count+=((brn or micro)?1:0)                         // One round-number category only.
    count+=(ema?1:0)
    count+=(trend?1:0)
    count+=(fib?1:0)
    count+=(mtfCluster?2:0)                          // Cross-timeframe agreement is stronger.
    count+=(premiumLiquidity?2:(sweepReclaim?1:0))  // Premium session/day sweep supersedes ordinary sweep.
    count+=(displacementChoch?2:0)
    count+=(emaSlope?1:0)
    count+=(emaRegime?1:0)
    count+=(vwapConfluence?1:0)
    count

f_nearest_above4(float reference,float a,float b,float c,float d)=>
    float result=na
    if not na(a) and a>reference
        result:=a
    if not na(b) and b>reference and (na(result) or b<result)
        result:=b
    if not na(c) and c>reference and (na(result) or c<result)
        result:=c
    if not na(d) and d>reference and (na(result) or d<result)
        result:=d
    result

f_nearest_below4(float reference,float a,float b,float c,float d)=>
    float result=na
    if not na(a) and a<reference
        result:=a
    if not na(b) and b<reference and (na(result) or b>result)
        result:=b
    if not na(c) and c<reference and (na(result) or c>result)
        result:=c
    if not na(d) and d<reference and (na(result) or d>result)
        result:=d
    result

//--------------------------------------------------------------------------------------------------
// Gold / BTC pip and round-number engine
//--------------------------------------------------------------------------------------------------
string symbolKey=str.upper(syminfo.ticker+" "+syminfo.root+" "+syminfo.description)
bool isGold=str.contains(symbolKey,"XAU") or str.contains(symbolKey,"GOLD")
bool isBTC=str.contains(symbolKey,"BTC") or str.contains(symbolKey,"XBT")
float pipSize=isGold?math.max(0.10,syminfo.mintick):isBTC?math.max(1.0,syminfo.mintick):syminfo.mintick
float brnStep=isGold?100.0:isBTC?1000.0:math.max(close*0.01,syminfo.mintick*100.0)
float microBrnStep=isGold?50.0:isBTC?500.0:brnStep*0.5
float confluenceTolerance=confluenceTolerancePips*pipSize
// Break-even activation uses M15 = 25 pips as the standard and square-root
// volatility-time scaling for the other supported chart timeframes. Defaults:
// M1 6 • M5 14 • M15 25 • M30 35 • H1 50 • H4 100 strategy pips.
float breakEvenTimeScale=math.sqrt(entrySeconds/900.0)
float breakEvenTriggerPips=math.max(1.0,math.round(breakEvenM15TriggerPips*breakEvenTimeScale))
float breakEvenTriggerDistance=breakEvenTriggerPips*pipSize
// Minimum second-level distance:
// XAUUSD: 70 points. With 0.10 per Gold point, this equals 7.0 price.
// BTCUSD: 70 points. With 1.00 per BTC point, this equals 70.0 price.
float goldSecondLevelDistance=70.0*pipSize
float btcSecondLevelDistance=70.0*pipSize
float minimumLevelDistance=isGold?goldSecondLevelDistance:isBTC?btcSecondLevelDistance:math.max(levelDistinctPips*pipSize,syminfo.mintick*5.0)
float stopBufferPips=mode=="SCALP"?scalpStopPips:mode=="INTRADAY"?intradayStopPips:swingStopPips
float targetMinimumPoints=mode=="SCALP"?scalpTargetMinPoints:mode=="INTRADAY"?intradayTargetMinPoints:swingTargetMinPoints
float targetMaximumPoints=mode=="SCALP"?scalpTargetMaxPoints:mode=="INTRADAY"?intradayTargetMaxPoints:swingTargetMaxPoints
float targetMinimumDistance=targetMinimumPoints*pipSize
float targetMaximumDistance=targetMaximumPoints*pipSize
float targetATRMultiplier=mode=="SCALP"?0.60:mode=="INTRADAY"?1.0:1.5
float stopATRMultiplier=mode=="SCALP"?0.40:mode=="INTRADAY"?0.60:0.85
int resultTTL=resultVisibleSeconds*1000
float chartATR=ta.atr(14)
float confirmedChartATR=ta.atr(14)[1]

//--------------------------------------------------------------------------------------------------
// Session / previous-day liquidity and daily VWAP context
//--------------------------------------------------------------------------------------------------
bool asiaActive=not na(time(timeframe.period,asiaSession,liquidityTimezone))
bool londonActive=not na(time(timeframe.period,londonSession,liquidityTimezone))
bool asiaWasActive=bar_index>0?asiaActive[1]:false
bool londonWasActive=bar_index>0?londonActive[1]:false
bool asiaStarted=asiaActive and not asiaWasActive
bool londonStarted=londonActive and not londonWasActive
bool asiaEnded=not asiaActive and asiaWasActive
bool londonEnded=not londonActive and londonWasActive

var float asiaRunningHigh=na
var float asiaRunningLow=na
var float completedAsiaHigh=na
var float completedAsiaLow=na
var int completedAsiaAt=na
var float londonRunningHigh=na
var float londonRunningLow=na
var float completedLondonHigh=na
var float completedLondonLow=na
var int completedLondonAt=na

if asiaStarted
    asiaRunningHigh:=high
    asiaRunningLow:=low
else if asiaActive
    asiaRunningHigh:=na(asiaRunningHigh)?high:math.max(asiaRunningHigh,high)
    asiaRunningLow:=na(asiaRunningLow)?low:math.min(asiaRunningLow,low)
if asiaEnded
    completedAsiaHigh:=asiaRunningHigh
    completedAsiaLow:=asiaRunningLow
    completedAsiaAt:=time
    asiaRunningHigh:=na
    asiaRunningLow:=na

if londonStarted
    londonRunningHigh:=high
    londonRunningLow:=low
else if londonActive
    londonRunningHigh:=na(londonRunningHigh)?high:math.max(londonRunningHigh,high)
    londonRunningLow:=na(londonRunningLow)?low:math.min(londonRunningLow,low)
if londonEnded
    completedLondonHigh:=londonRunningHigh
    completedLondonLow:=londonRunningLow
    completedLondonAt:=time
    londonRunningHigh:=na
    londonRunningLow:=na

int sessionLevelMaxAgeMs=sessionLevelMaxAgeHours*60*60*1000
bool asiaLevelFresh=not na(completedAsiaAt) and time-completedAsiaAt<=sessionLevelMaxAgeMs
bool londonLevelFresh=not na(completedLondonAt) and time-completedLondonAt<=sessionLevelMaxAgeMs

// Daily VWAP uses the chart's actual volume series. On OANDA spot gold this is
// broker tick activity; it is therefore a soft confluence, never a hard filter.
bool newVwapDay=timeframe.change("D")
float vwapBarVolume=nz(volume,0.0)
var float dailyVwapPV=na
var float dailyVwapVolume=na
if newVwapDay or na(dailyVwapPV)
    dailyVwapPV:=hlc3*vwapBarVolume
    dailyVwapVolume:=vwapBarVolume
else
    dailyVwapPV+=hlc3*vwapBarVolume
    dailyVwapVolume+=vwapBarVolume
float dailyVWAPRaw=not na(dailyVwapVolume) and dailyVwapVolume>0?dailyVwapPV/dailyVwapVolume:na
float entryVWAP=dailyVWAPRaw[1]
float entryVWAPPrevious=dailyVWAPRaw[2]

//--------------------------------------------------------------------------------------------------
// Confirmed timeframe data
//--------------------------------------------------------------------------------------------------
[entryReference,entryBiasEMA]=request.security(
    syminfo.tickerid,entryTf,
    [close[1],ta.ema(close,directionEmaLength)[1]],
    gaps=barmerge.gaps_off,lookahead=barmerge.lookahead_on)

[dirCloseBank1,dirCloseBank2,dirCloseBank3,dirCloseBank4,dirCloseBank5,dirCloseBank6,dirCloseBank7,dirCloseBank8,dirCloseBank9,dirCloseBank10,dirCloseBank11,dirCloseBank12,dirCloseBank13,dirCloseBank14,dirCloseBank15,dirCloseBank16,dirCloseBank17,dirCloseBank18,dirCloseBank19,dirCloseBank20,dirCloseBank21,dirCloseBank22,dirCloseBank23,dirCloseBank24,dirCloseBank25,dirCloseBank26,dirCloseBank27,dirCloseBank28,dirCloseBank29,dirCloseBank30,dirCloseBank31,dirCloseBank32,dirCloseBank33,dirCloseBank34,dirCloseBank35,dirCloseBank36,dirCloseBank37,dirCloseBank38,dirCloseBank39,dirCloseBank40,dirCloseBank41,dirCloseBank42,dirCloseBank43,dirCloseBank44,dirCloseBank45,dirCloseBank46,dirCloseBank47,dirCloseBank48,dirCloseBank49,dirCloseBank50,dirCloseBank51,dirCloseBank52,dirCloseBank53,dirCloseBank54,dirCloseBank55,dirCloseBank56,dirCloseBank57,dirCloseBank58,dirCloseBank59,dirCloseBank60,dirCloseBank61,dirCloseBank62,dirCloseBank63,dirCloseBank64]=request.security(syminfo.tickerid,directionTf,f_direction_bank(),gaps=barmerge.gaps_off,lookahead=barmerge.lookahead_on)
array<float> directionCloses=array.from(dirCloseBank1,dirCloseBank2,dirCloseBank3,dirCloseBank4,dirCloseBank5,dirCloseBank6,dirCloseBank7,dirCloseBank8,dirCloseBank9,dirCloseBank10,dirCloseBank11,dirCloseBank12,dirCloseBank13,dirCloseBank14,dirCloseBank15,dirCloseBank16,dirCloseBank17,dirCloseBank18,dirCloseBank19,dirCloseBank20,dirCloseBank21,dirCloseBank22,dirCloseBank23,dirCloseBank24,dirCloseBank25,dirCloseBank26,dirCloseBank27,dirCloseBank28,dirCloseBank29,dirCloseBank30,dirCloseBank31,dirCloseBank32,dirCloseBank33,dirCloseBank34,dirCloseBank35,dirCloseBank36,dirCloseBank37,dirCloseBank38,dirCloseBank39,dirCloseBank40,dirCloseBank41,dirCloseBank42,dirCloseBank43,dirCloseBank44,dirCloseBank45,dirCloseBank46,dirCloseBank47,dirCloseBank48,dirCloseBank49,dirCloseBank50,dirCloseBank51,dirCloseBank52,dirCloseBank53,dirCloseBank54,dirCloseBank55,dirCloseBank56,dirCloseBank57,dirCloseBank58,dirCloseBank59,dirCloseBank60,dirCloseBank61,dirCloseBank62,dirCloseBank63,dirCloseBank64)

[directionClose,directionEMA,directionEMAPrevious,directionEMA50,directionEMA50Previous,directionATR,directionLowest,directionHighest]=request.security(
    syminfo.tickerid,directionTf,
    [close[1],ta.ema(close,directionEmaLength)[1],ta.ema(close,directionEmaLength)[2],ta.ema(close,regimeEmaLength)[1],ta.ema(close,regimeEmaLength)[2],ta.atr(14)[1],ta.lowest(low,100)[1],ta.highest(high,100)[1]],
    gaps=barmerge.gaps_off,lookahead=barmerge.lookahead_on)

[supportHigh1,supportHigh2,supportHigh3,supportHigh4,supportHigh5,supportHigh6,supportHigh7,supportHigh8,supportHigh9,supportHigh10,supportHigh11,supportHigh12,supportHigh13,supportHigh14,supportHigh15,supportHigh16,supportHigh17,supportHigh18,supportHigh19,supportHigh20,supportHigh21,supportHigh22,supportHigh23,supportHigh24,supportHigh25,supportHigh26,supportHigh27,supportHigh28,supportHigh29,supportHigh30,supportHigh31,supportHigh32,supportHigh33,supportHigh34,supportHigh35,supportHigh36,supportHigh37,supportHigh38,supportHigh39,supportHigh40,supportLow1,supportLow2,supportLow3,supportLow4,supportLow5,supportLow6,supportLow7,supportLow8,supportLow9,supportLow10,supportLow11,supportLow12,supportLow13,supportLow14,supportLow15,supportLow16,supportLow17,supportLow18,supportLow19,supportLow20,supportLow21,supportLow22,supportLow23,supportLow24,supportLow25,supportLow26,supportLow27,supportLow28,supportLow29,supportLow30,supportLow31,supportLow32,supportLow33,supportLow34,supportLow35,supportLow36,supportLow37,supportLow38,supportLow39,supportLow40,supportTime1,supportTime2,supportTime3,supportTime4,supportTime5,supportTime6,supportTime7,supportTime8,supportTime9,supportTime10,supportTime11,supportTime12,supportTime13,supportTime14,supportTime15,supportTime16,supportTime17,supportTime18,supportTime19,supportTime20,supportTime21,supportTime22,supportTime23,supportTime24,supportTime25,supportTime26,supportTime27,supportTime28,supportTime29,supportTime30,supportTime31,supportTime32,supportTime33,supportTime34,supportTime35,supportTime36,supportTime37,supportTime38,supportTime39,supportTime40]=request.security(syminfo.tickerid,supportTf,f_support_bank(),gaps=barmerge.gaps_off,lookahead=barmerge.lookahead_on)
array<float> supportHighs=array.from(supportHigh1,supportHigh2,supportHigh3,supportHigh4,supportHigh5,supportHigh6,supportHigh7,supportHigh8,supportHigh9,supportHigh10,supportHigh11,supportHigh12,supportHigh13,supportHigh14,supportHigh15,supportHigh16,supportHigh17,supportHigh18,supportHigh19,supportHigh20,supportHigh21,supportHigh22,supportHigh23,supportHigh24,supportHigh25,supportHigh26,supportHigh27,supportHigh28,supportHigh29,supportHigh30,supportHigh31,supportHigh32,supportHigh33,supportHigh34,supportHigh35,supportHigh36,supportHigh37,supportHigh38,supportHigh39,supportHigh40)
array<float> supportLows=array.from(supportLow1,supportLow2,supportLow3,supportLow4,supportLow5,supportLow6,supportLow7,supportLow8,supportLow9,supportLow10,supportLow11,supportLow12,supportLow13,supportLow14,supportLow15,supportLow16,supportLow17,supportLow18,supportLow19,supportLow20,supportLow21,supportLow22,supportLow23,supportLow24,supportLow25,supportLow26,supportLow27,supportLow28,supportLow29,supportLow30,supportLow31,supportLow32,supportLow33,supportLow34,supportLow35,supportLow36,supportLow37,supportLow38,supportLow39,supportLow40)
array<int> supportTimes=array.from(supportTime1,supportTime2,supportTime3,supportTime4,supportTime5,supportTime6,supportTime7,supportTime8,supportTime9,supportTime10,supportTime11,supportTime12,supportTime13,supportTime14,supportTime15,supportTime16,supportTime17,supportTime18,supportTime19,supportTime20,supportTime21,supportTime22,supportTime23,supportTime24,supportTime25,supportTime26,supportTime27,supportTime28,supportTime29,supportTime30,supportTime31,supportTime32,supportTime33,supportTime34,supportTime35,supportTime36,supportTime37,supportTime38,supportTime39,supportTime40)

[supportEMA,supportTrendSupport,supportTrendResistance,supportSwingHigh,supportSwingLow,supportATR]=request.security(
    syminfo.tickerid,supportTf,f_support_metrics(supportPivotBars,directionEmaLength),
    gaps=barmerge.gaps_off,lookahead=barmerge.lookahead_on)

[entryOpen1,entryOpen2,entryHigh1,entryHigh2,entryHigh3,entryHigh4,entryHigh5,entryHigh6,entryHigh7,entryHigh8,entryHigh9,entryHigh10,entryHigh11,entryHigh12,entryHigh13,entryHigh14,entryHigh15,entryHigh16,entryHigh17,entryHigh18,entryHigh19,entryHigh20,entryHigh21,entryHigh22,entryHigh23,entryHigh24,entryLow1,entryLow2,entryLow3,entryLow4,entryLow5,entryLow6,entryLow7,entryLow8,entryLow9,entryLow10,entryLow11,entryLow12,entryLow13,entryLow14,entryLow15,entryLow16,entryLow17,entryLow18,entryLow19,entryLow20,entryLow21,entryLow22,entryLow23,entryLow24,entryClose1,entryClose2,entryTime1,entryTime2,entryTime3,entryTime4,entryTime5,entryTime6,entryTime7,entryTime8,entryTime9,entryTime10,entryTime11,entryTime12,entryTime13,entryTime14,entryTime15,entryTime16,entryTime17,entryTime18,entryTime19,entryTime20,entryTime21,entryTime22,entryTime23,entryTime24]=request.security(syminfo.tickerid,entryTf,f_entry_bank(),gaps=barmerge.gaps_off,lookahead=barmerge.lookahead_on)
array<float> entryHighs=array.from(entryHigh1,entryHigh2,entryHigh3,entryHigh4,entryHigh5,entryHigh6,entryHigh7,entryHigh8,entryHigh9,entryHigh10,entryHigh11,entryHigh12,entryHigh13,entryHigh14,entryHigh15,entryHigh16,entryHigh17,entryHigh18,entryHigh19,entryHigh20,entryHigh21,entryHigh22,entryHigh23,entryHigh24)
array<float> entryLows=array.from(entryLow1,entryLow2,entryLow3,entryLow4,entryLow5,entryLow6,entryLow7,entryLow8,entryLow9,entryLow10,entryLow11,entryLow12,entryLow13,entryLow14,entryLow15,entryLow16,entryLow17,entryLow18,entryLow19,entryLow20,entryLow21,entryLow22,entryLow23,entryLow24)
array<int> entryTimes=array.from(entryTime1,entryTime2,entryTime3,entryTime4,entryTime5,entryTime6,entryTime7,entryTime8,entryTime9,entryTime10,entryTime11,entryTime12,entryTime13,entryTime14,entryTime15,entryTime16,entryTime17,entryTime18,entryTime19,entryTime20,entryTime21,entryTime22,entryTime23,entryTime24)

[previousDayHigh,previousDayLow]=request.security(
    syminfo.tickerid,"D",[high[1],low[1]],
    gaps=barmerge.gaps_off,lookahead=barmerge.lookahead_on)


//--------------------------------------------------------------------------------------------------
// One mapping engine used by both drawing and signals
//--------------------------------------------------------------------------------------------------
[S1,S2,R1,R2]=f_pick_direction_levels(directionCloses,entryReference,minimumLevelDistance,directionLowest,directionHighest,directionATR)

bool bullishBias=directionClose>directionEMA
bool bearishBias=directionClose<directionEMA

// Frequency profile: selected timeframe may sit slightly across EMA13.
// Direction-timeframe EMA13 bias remains strict.
float entryBiasTolerance=math.max(nz(supportATR,0.0)*0.60,pipSize*15.0)
bool entryBullishBias=entryReference>=entryBiasEMA-entryBiasTolerance
bool entryBearishBias=entryReference<=entryBiasEMA+entryBiasTolerance
string biasText=bullishBias?"BULLISH":bearishBias?"BEARISH":"NEUTRAL"

float directionSlopeATR=(directionEMA-directionEMAPrevious)/math.max(nz(directionATR,syminfo.mintick),syminfo.mintick)
bool buyEmaSlopeConfluence=useEmaRegime and directionSlopeATR>=emaSlopeMinATR
bool sellEmaSlopeConfluence=useEmaRegime and directionSlopeATR<=-emaSlopeMinATR
bool buyEmaRegimeConfluence=useEmaRegime and directionClose>directionEMA and directionEMA>directionEMA50 and directionEMA50>=directionEMA50Previous
bool sellEmaRegimeConfluence=useEmaRegime and directionClose<directionEMA and directionEMA<directionEMA50 and directionEMA50<=directionEMA50Previous


bool trendBuyRoute=bullishBias and entryBullishBias
bool trendSellRoute=bearishBias and entryBearishBias

// Counter-trend routes require opposite direction-timeframe bias together with
// selected/entry-timeframe alignment in the proposed trade direction.
bool counterTrendBuyRoute=bearishBias and entryBullishBias
bool counterTrendSellRoute=bullishBias and entryBearishBias

[buyHighLo,buyHighHi,buyHighTime]=f_support_zone(S1,supportHighs,supportLows,supportTimes)
[buyLowLo,buyLowHi,buyLowTime]=f_support_zone(S2,supportHighs,supportLows,supportTimes)
[sellHighLo,sellHighHi,sellHighTime]=f_support_zone(R1,supportHighs,supportLows,supportTimes)
[sellLowLo,sellLowHi,sellLowTime]=f_support_zone(R2,supportHighs,supportLows,supportTimes)

float supportRange=math.abs(supportSwingHigh-supportSwingLow)
float buyFib50=not na(supportRange)?supportSwingHigh-supportRange*0.50:na
float buyFib618=not na(supportRange)?supportSwingHigh-supportRange*0.618:na
float sellFib50=not na(supportRange)?supportSwingLow+supportRange*0.50:na
float sellFib618=not na(supportRange)?supportSwingLow+supportRange*0.618:na

[entryClusterHigh,entryClusterLow]=f_recent_extremes(entryHighs,entryLows,sweepLookbackBars)
float clusterTolerance=math.min(confluenceTolerance,math.max(nz(supportATR,pipSize*20.0)*0.35,pipSize*10.0))
bool buyHighMtfCluster=useMtfLevelCluster and f_mtf_cluster(S1,buyHighLo,buyHighHi,supportSwingLow,supportTrendSupport,supportEMA,entryClusterLow,clusterTolerance)
bool sellHighMtfCluster=useMtfLevelCluster and f_mtf_cluster(R1,sellHighLo,sellHighHi,supportSwingHigh,supportTrendResistance,supportEMA,entryClusterHigh,clusterTolerance)

float vwapTolerance=math.max(pipSize*5.0,nz(confirmedChartATR,pipSize*20.0)*vwapToleranceATR)
float buyZoneMid=(buyHighLo+buyHighHi)/2.0
float sellZoneMid=(sellHighLo+sellHighHi)/2.0

//--------------------------------------------------------------------------------------------------
// Selected-timeframe confirmation engine
//--------------------------------------------------------------------------------------------------
// Confirmation comes from the routed entry timeframe, which may be lower than
// the chart timeframe. Only confirmed entry-timeframe candles are processed.
float entryCandleOpen=entryOpen1
float entryCandleHigh=entryHigh1
float entryCandleLow=entryLow1
float entryCandleClose=entryClose1
int entryCandleTime=entryTime1

float entryPrevClose=entryClose2

bool buyVWAPConfluence=useVWAP and not na(entryVWAP) and ((f_near(buyZoneMid,entryVWAP,vwapTolerance) and entryVWAP>=entryVWAPPrevious) or (entryCandleLow<entryVWAP and entryCandleClose>entryVWAP))
bool sellVWAPConfluence=useVWAP and not na(entryVWAP) and ((f_near(sellZoneMid,entryVWAP,vwapTolerance) and entryVWAP<=entryVWAPPrevious) or (entryCandleHigh>entryVWAP and entryCandleClose<entryVWAP))

varip int entryStructureDirection=0
varip int lastProcessedEntryTime=na
varip float lastBullishSweepLow=na
varip float lastBullishSweepHigh=na
varip int lastBullishSweepTime=na
varip float lastBearishSweepLow=na
varip float lastBearishSweepHigh=na
varip int lastBearishSweepTime=na
varip float lastBullishPremiumSweepLow=na
varip float lastBullishPremiumSweepHigh=na
varip int lastBullishPremiumSweepTime=na
varip string lastBullishPremiumSweepType=""
varip float lastBearishPremiumSweepLow=na
varip float lastBearishPremiumSweepHigh=na
varip int lastBearishPremiumSweepTime=na
varip string lastBearishPremiumSweepType=""
varip float lastBullishDisplacementLow=na
varip float lastBullishDisplacementHigh=na
varip int lastBullishDisplacementTime=na
varip float lastBearishDisplacementLow=na
varip float lastBearishDisplacementHigh=na
varip int lastBearishDisplacementTime=na

bool freshEntryClose=chartMatchesSelected and not na(entryCandleTime) and (na(lastProcessedEntryTime) or entryCandleTime>lastProcessedEntryTime)
bool bullishChochEvent=false
bool bearishChochEvent=false
bool bullishDisplacementChochEvent=false
bool bearishDisplacementChochEvent=false
bool bullishRejectionEvent=false
bool bearishRejectionEvent=false
bool bullishSweepReclaimEvent=false
bool bearishSweepReclaimEvent=false
bool bullishPremiumLiquidityEvent=false
bool bearishPremiumLiquidityEvent=false

float entryCandleRange=entryCandleHigh-entryCandleLow
float entryCandleBody=math.abs(entryCandleClose-entryCandleOpen)
float entrySafeBody=math.max(entryCandleBody,syminfo.mintick)
float entryLowerWick=math.min(entryCandleOpen,entryCandleClose)-entryCandleLow
float entryUpperWick=entryCandleHigh-math.max(entryCandleOpen,entryCandleClose)
bool bullishBody=entryCandleClose>entryCandleOpen
bool bearishBody=entryCandleClose<entryCandleOpen
float entryBodyPct=entryCandleRange>0?entryCandleBody/entryCandleRange:0.0
float bullishClosePosition=entryCandleRange>0?(entryCandleClose-entryCandleLow)/entryCandleRange:0.0
float bearishClosePosition=entryCandleRange>0?(entryCandleHigh-entryCandleClose)/entryCandleRange:0.0
float displacementATR=math.max(nz(confirmedChartATR,syminfo.mintick),syminfo.mintick)

float recentEntryHigh=na
float recentEntryLow=na
int structureLookback=math.min(array.size(entryHighs)-1,math.max(entryPivotBars*2+2,sweepLookbackBars))

for i=1 to structureLookback
    float historicalHigh=array.get(entryHighs,i)
    float historicalLow=array.get(entryLows,i)
    recentEntryHigh:=na(recentEntryHigh)?historicalHigh:math.max(recentEntryHigh,historicalHigh)
    recentEntryLow:=na(recentEntryLow)?historicalLow:math.min(recentEntryLow,historicalLow)

if freshEntryClose
    // Ordinary CHOCH keeps the proven v4.5.2 fast structure recognition.
    bool bullishBreak=not na(recentEntryHigh) and entryCandleHigh>recentEntryHigh and entryCandleClose>entryPrevClose
    bool bearishBreak=not na(recentEntryLow) and entryCandleLow<recentEntryLow and entryCandleClose<entryPrevClose

    bullishChochEvent:=bullishBreak and entryStructureDirection<=0 and (not requireDirectionalBody or bullishBody)
    bearishChochEvent:=bearishBreak and entryStructureDirection>=0 and (not requireDirectionalBody or bearishBody)

    // Displacement-quality CHOCH requires a completed close beyond structure,
    // meaningful ATR expansion, a dominant body and a close near the candle extreme.
    bool bullishDisplacementBreak=not na(recentEntryHigh) and entryCandleClose>=recentEntryHigh+displacementATR*displacementMinBreakATR
    bool bearishDisplacementBreak=not na(recentEntryLow) and entryCandleClose<=recentEntryLow-displacementATR*displacementMinBreakATR
    bullishDisplacementChochEvent:=useDisplacementChoch and entryStructureDirection<=0 and bullishBody and entryCandleRange>=displacementATR*displacementMinRangeATR and entryBodyPct>=displacementMinBodyPct and bullishClosePosition>=0.70 and bullishDisplacementBreak
    bearishDisplacementChochEvent:=useDisplacementChoch and entryStructureDirection>=0 and bearishBody and entryCandleRange>=displacementATR*displacementMinRangeATR and entryBodyPct>=displacementMinBodyPct and bearishClosePosition>=0.70 and bearishDisplacementBreak

    // A rejection only needs a directional body, meaningful wick and a close
    // back inside the stronger half of the candle.
    bullishRejectionEvent:=bullishBody and entryLowerWick>=entrySafeBody*rejectionWickRatio and entryCandleClose>=entryCandleLow+entryCandleRange*0.45
    bearishRejectionEvent:=bearishBody and entryUpperWick>=entrySafeBody*rejectionWickRatio and entryCandleClose<=entryCandleHigh-entryCandleRange*0.45

    // Ordinary completed reclaim of the recent routed-timeframe liquidity pool.
    bullishSweepReclaimEvent:=useSweepReclaim and not na(recentEntryLow) and entryCandleLow<recentEntryLow and entryCandleClose>recentEntryLow and (not requireDirectionalBody or bullishBody)
    bearishSweepReclaimEvent:=useSweepReclaim and not na(recentEntryHigh) and entryCandleHigh>recentEntryHigh and entryCandleClose<recentEntryHigh and (not requireDirectionalBody or bearishBody)

    // Premium liquidity levels: previous day, completed Asian session and
    // completed London session. Reclaim must complete on the selected chart timeframe.
    bool bullishPreviousDaySweep=useSessionDayLiquidity and not na(previousDayLow) and entryCandleLow<previousDayLow and entryCandleClose>previousDayLow and (not requireDirectionalBody or bullishBody)
    bool bearishPreviousDaySweep=useSessionDayLiquidity and not na(previousDayHigh) and entryCandleHigh>previousDayHigh and entryCandleClose<previousDayHigh and (not requireDirectionalBody or bearishBody)
    bool bullishAsiaSweep=useSessionDayLiquidity and asiaLevelFresh and not na(completedAsiaLow) and not na(completedAsiaAt) and entryCandleTime>=completedAsiaAt and entryCandleLow<completedAsiaLow and entryCandleClose>completedAsiaLow and (not requireDirectionalBody or bullishBody)
    bool bearishAsiaSweep=useSessionDayLiquidity and asiaLevelFresh and not na(completedAsiaHigh) and not na(completedAsiaAt) and entryCandleTime>=completedAsiaAt and entryCandleHigh>completedAsiaHigh and entryCandleClose<completedAsiaHigh and (not requireDirectionalBody or bearishBody)
    bool bullishLondonSweep=useSessionDayLiquidity and londonLevelFresh and not na(completedLondonLow) and not na(completedLondonAt) and entryCandleTime>=completedLondonAt and entryCandleLow<completedLondonLow and entryCandleClose>completedLondonLow and (not requireDirectionalBody or bullishBody)
    bool bearishLondonSweep=useSessionDayLiquidity and londonLevelFresh and not na(completedLondonHigh) and not na(completedLondonAt) and entryCandleTime>=completedLondonAt and entryCandleHigh>completedLondonHigh and entryCandleClose<completedLondonHigh and (not requireDirectionalBody or bearishBody)

    bullishPremiumLiquidityEvent:=bullishPreviousDaySweep or bullishAsiaSweep or bullishLondonSweep
    bearishPremiumLiquidityEvent:=bearishPreviousDaySweep or bearishAsiaSweep or bearishLondonSweep

    if bullishSweepReclaimEvent
        lastBullishSweepLow:=entryCandleLow
        lastBullishSweepHigh:=entryCandleHigh
        lastBullishSweepTime:=entryCandleTime

    if bearishSweepReclaimEvent
        lastBearishSweepLow:=entryCandleLow
        lastBearishSweepHigh:=entryCandleHigh
        lastBearishSweepTime:=entryCandleTime

    if bullishPremiumLiquidityEvent
        lastBullishPremiumSweepLow:=entryCandleLow
        lastBullishPremiumSweepHigh:=entryCandleHigh
        lastBullishPremiumSweepTime:=entryCandleTime
        lastBullishPremiumSweepType:=bullishPreviousDaySweep?"PREVIOUS-DAY LOW":bullishAsiaSweep?"ASIAN LOW":"LONDON LOW"

    if bearishPremiumLiquidityEvent
        lastBearishPremiumSweepLow:=entryCandleLow
        lastBearishPremiumSweepHigh:=entryCandleHigh
        lastBearishPremiumSweepTime:=entryCandleTime
        lastBearishPremiumSweepType:=bearishPreviousDaySweep?"PREVIOUS-DAY HIGH":bearishAsiaSweep?"ASIAN HIGH":"LONDON HIGH"

    if bullishDisplacementChochEvent
        lastBullishDisplacementLow:=entryCandleLow
        lastBullishDisplacementHigh:=entryCandleHigh
        lastBullishDisplacementTime:=entryCandleTime

    if bearishDisplacementChochEvent
        lastBearishDisplacementLow:=entryCandleLow
        lastBearishDisplacementHigh:=entryCandleHigh
        lastBearishDisplacementTime:=entryCandleTime

    if bullishBreak
        entryStructureDirection:=1
    if bearishBreak
        entryStructureDirection:=-1

    lastProcessedEntryTime:=entryCandleTime

//--------------------------------------------------------------------------------------------------
// Signal state machine
//--------------------------------------------------------------------------------------------------
// `varip` preserves intrabar changes across realtime ticks.
// This prevents READY/LIVE states from rolling back and disappearing.
varip string state="MONITORING"
varip string armedSetupId=""
varip string armedDirection="NONE"
varip string armedRisk=""
varip string armedConfirmation=""
varip bool armedCounterTrend=false
varip bool armedMtfCluster=false
varip bool armedSweepReclaim=false
varip bool armedPremiumLiquidity=false
varip bool armedDisplacementChoch=false
varip bool armedEmaSlope=false
varip bool armedEmaRegime=false
varip bool armedVWAP=false
varip int armedRequiredConfluences=TREND_MIN_CONFLUENCES
varip int armedAtBar=na
varip int armedAtClock=na
varip int armedConfluences=0
varip float armedSupportLo=na
varip float armedSupportHi=na
varip int armedZoneRetests=0
varip bool armedZoneExited=false
varip float armedEntryLo=na
varip float armedEntryHi=na
varip int armedEntryTime=na
varip string armedExtraReasons=""

// First-touch latch. Once the armed rectangle is touched, the event remains
// stored even when price leaves the rectangle later in the same candle.
varip bool armedTouchLatched=false
varip float armedTouchPrice=na

// Immutable LIVE trade snapshot. These fields are written once when LIVE starts
// and cannot be changed by later direction/support/entry candle closes.
varip bool liveTradeLocked=false
varip string activeSetupId=""
varip string activeDirection="NONE"
varip string activeRisk=""
varip string activeConfirmation=""
varip string activeExtraReasons=""
varip bool activeCounterTrend=false
varip int activeConfluences=0
varip float activeEntry=na
varip float activeSL=na
varip float activeTP=na
varip float activeEntryLo=na
varip float activeEntryHi=na
varip int activeEntryTime=na
varip float activeExit=na
varip float activeResultPips=na
varip float activeRR=na
varip float activeMarkerPrice=na
varip int activeStartBar=na
varip int activeStartTime=na
varip bool activeBreakEvenArmed=false
varip float activeBreakEvenTriggerPips=na
varip float activeBreakEvenTriggerPrice=na
varip int resultStartedAt=na
varip int resultHideAt=na

// Event-alert deduplication. alert.freq_all is safe because each immutable
// setup/state key is allowed to emit only once. This prevents READY/LIVE/result
// events in the same chart bar from suppressing one another.
varip string lastReadyAlertKey=""
varip string lastLiveAlertKey=""
varip string lastResultAlertKey=""

// Independent TP/SL/BE card snapshot. Once a result is detected, every value shown
// on the card is frozen for the full 10-second display window.
varip string resultCardStatus="NONE"
varip string resultCardSetupId=""
varip string resultCardDirection="NONE"
varip string resultCardRisk=""
varip string resultCardConfirmation=""
varip string resultCardExtraReasons=""
varip int resultCardConfluences=0
varip float resultCardEntry=na
varip float resultCardSL=na
varip float resultCardTP=na
varip float resultCardExit=na
varip float resultCardPips=na

// Permanent marker ledger. Historical reconstruction and alert-synced realtime
// events share one capped collection, but their tooltips identify the source.
// Labels are created once at commitment and remain until they become older than
// the newest 33 signals. This avoids delete/rebuild flicker on every live tick.
var array<string> permanentMarkerSetupIds=array.new_string()
var array<label> permanentMarkerLabels=array.new_label()

// LOW RISK zones are drawing-only. After TP, SL or BE, the engine returns to
// MONITORING and waits for a fresh HIGH RISK setup.
var label currentLiveSignalMarker=na

bool armedEvent=false
bool liveEvent=false
bool realtimeLiveEvent=false
bool tpEvent=false
bool slEvent=false
bool beEvent=false

// READY requires a recent entry-zone rejection or completed sweep/reclaim.
// The confirmation remains valid for the current candle plus the next
// four routed entry-timeframe candles to increase nearby valid setups.
const int ARMED_CONFIRMATION_WINDOW=4
int bullishChochAge=ta.barssince(bullishChochEvent)
int bearishChochAge=ta.barssince(bearishChochEvent)
int bullishRejectionAge=ta.barssince(bullishRejectionEvent)
int bearishRejectionAge=ta.barssince(bearishRejectionEvent)
int bullishSweepAge=ta.barssince(bullishSweepReclaimEvent)
int bearishSweepAge=ta.barssince(bearishSweepReclaimEvent)
int bullishPremiumSweepAge=ta.barssince(bullishPremiumLiquidityEvent)
int bearishPremiumSweepAge=ta.barssince(bearishPremiumLiquidityEvent)
int bullishDisplacementAge=ta.barssince(bullishDisplacementChochEvent)
int bearishDisplacementAge=ta.barssince(bearishDisplacementChochEvent)

bool bullishRecentChoch=not na(bullishChochAge) and bullishChochAge<=ARMED_CONFIRMATION_WINDOW
bool bearishRecentChoch=not na(bearishChochAge) and bearishChochAge<=ARMED_CONFIRMATION_WINDOW
bool bullishRecentRejection=not na(bullishRejectionAge) and bullishRejectionAge<=ARMED_CONFIRMATION_WINDOW
bool bearishRecentRejection=not na(bearishRejectionAge) and bearishRejectionAge<=ARMED_CONFIRMATION_WINDOW
bool bullishRecentSweep=not na(bullishSweepAge) and bullishSweepAge<=ARMED_CONFIRMATION_WINDOW
bool bearishRecentSweep=not na(bearishSweepAge) and bearishSweepAge<=ARMED_CONFIRMATION_WINDOW
bool bullishRecentPremiumSweep=not na(bullishPremiumSweepAge) and bullishPremiumSweepAge<=ARMED_CONFIRMATION_WINDOW
bool bearishRecentPremiumSweep=not na(bearishPremiumSweepAge) and bearishPremiumSweepAge<=ARMED_CONFIRMATION_WINDOW
bool bullishRecentDisplacement=not na(bullishDisplacementAge) and bullishDisplacementAge<=ARMED_CONFIRMATION_WINDOW
bool bearishRecentDisplacement=not na(bearishDisplacementAge) and bearishDisplacementAge<=ARMED_CONFIRMATION_WINDOW

// Every reversal event must remain spatially connected to the active HIGH RISK zone.
bool bullishSweepInBuyZone=bullishRecentSweep and not na(lastBullishSweepTime) and f_overlap(lastBullishSweepLow,lastBullishSweepHigh,buyHighLo,buyHighHi)
bool bearishSweepInSellZone=bearishRecentSweep and not na(lastBearishSweepTime) and f_overlap(lastBearishSweepLow,lastBearishSweepHigh,sellHighLo,sellHighHi)
bool bullishPremiumSweepInBuyZone=bullishRecentPremiumSweep and not na(lastBullishPremiumSweepTime) and f_overlap(lastBullishPremiumSweepLow,lastBullishPremiumSweepHigh,buyHighLo,buyHighHi)
bool bearishPremiumSweepInSellZone=bearishRecentPremiumSweep and not na(lastBearishPremiumSweepTime) and f_overlap(lastBearishPremiumSweepLow,lastBearishPremiumSweepHigh,sellHighLo,sellHighHi)
bool bullishDisplacementInBuyZone=bullishRecentDisplacement and not na(lastBullishDisplacementTime) and f_overlap(lastBullishDisplacementLow,lastBullishDisplacementHigh,buyHighLo,buyHighHi)
bool bearishDisplacementInSellZone=bearishRecentDisplacement and not na(lastBearishDisplacementTime) and f_overlap(lastBearishDisplacementLow,lastBearishDisplacementHigh,sellHighLo,sellHighHi)
bool bullishAnySweepInBuyZone=bullishSweepInBuyZone or bullishPremiumSweepInBuyZone
bool bearishAnySweepInSellZone=bearishSweepInSellZone or bearishPremiumSweepInSellZone

// Rejection keeps the original frequency. Premium sweep-reclaim and displacement
// CHOCH create additional valid confirmation paths instead of acting as hard filters.
bool bullishArmedConfirmation=bullishRecentRejection or bullishAnySweepInBuyZone or bullishDisplacementInBuyZone
bool bearishArmedConfirmation=bearishRecentRejection or bearishAnySweepInSellZone or bearishDisplacementInSellZone

string bullishConfirmationName=bullishPremiumSweepInBuyZone?"SESSION / PREVIOUS-DAY SWEEP + RECLAIM":bullishSweepInBuyZone?"LIQUIDITY SWEEP + RECLAIM":bullishDisplacementInBuyZone?"DISPLACEMENT CHOCH":bullishRecentRejection?"ENTRY ZONE REJECTION":""
string bearishConfirmationName=bearishPremiumSweepInSellZone?"SESSION / PREVIOUS-DAY SWEEP + RECLAIM":bearishSweepInSellZone?"LIQUIDITY SWEEP + RECLAIM":bearishDisplacementInSellZone?"DISPLACEMENT CHOCH":bearishRecentRejection?"ENTRY ZONE REJECTION":""

int buyHighConfluences=f_confluence_count(buyHighLo,buyHighHi,S1,supportEMA,supportTrendSupport,buyFib50,buyFib618,brnStep,microBrnStep,confluenceTolerance,buyHighMtfCluster,bullishSweepInBuyZone,bullishPremiumSweepInBuyZone,bullishDisplacementInBuyZone,buyEmaSlopeConfluence,buyEmaRegimeConfluence,buyVWAPConfluence)
int sellHighConfluences=f_confluence_count(sellHighLo,sellHighHi,R1,supportEMA,supportTrendResistance,sellFib50,sellFib618,brnStep,microBrnStep,confluenceTolerance,sellHighMtfCluster,bearishSweepInSellZone,bearishPremiumSweepInSellZone,bearishDisplacementInSellZone,sellEmaSlopeConfluence,sellEmaRegimeConfluence,sellVWAPConfluence)

// READY entry rectangles stay entirely below CMP for BUY and above CMP for SELL.
float readySideBuffer=syminfo.mintick

// Fresh MONITORING signals use HIGH RISK zones only.
// LOW RISK zones remain visible strictly as chart drawings.
if state=="MONITORING" and not liveTradeLocked and freshEntryClose
    int buyHighRetests=f_zone_retest_count(buyHighLo,buyHighHi,buyHighTime,entryCandleTime,supportSeconds,entryHighs,entryLows,entryTimes)
    int sellHighRetests=f_zone_retest_count(sellHighLo,sellHighHi,sellHighTime,entryCandleTime,supportSeconds,entryHighs,entryLows,entryTimes)

    bool buyHighRetestValid=buyHighRetests<=MAXIMUM_ZONE_RETESTS
    bool sellHighRetestValid=sellHighRetests<=MAXIMUM_ZONE_RETESTS
    bool buyIsCounterTrend=counterTrendBuyRoute and not trendBuyRoute
    bool sellIsCounterTrend=counterTrendSellRoute and not trendSellRoute
    bool allowBuy=trendBuyRoute or buyIsCounterTrend
    bool allowSell=trendSellRoute or sellIsCounterTrend
    bool buyReversalValid=not buyIsCounterTrend or bullishDisplacementInBuyZone or bullishAnySweepInBuyZone
    bool sellReversalValid=not sellIsCounterTrend or bearishDisplacementInSellZone or bearishAnySweepInSellZone
    bool buyConfirmationValid=allowBuy and bullishArmedConfirmation and buyReversalValid
    bool sellConfirmationValid=allowSell and bearishArmedConfirmation and sellReversalValid
    int buyRequiredConfluences=buyIsCounterTrend?COUNTERTREND_MIN_CONFLUENCES:TREND_MIN_CONFLUENCES
    int sellRequiredConfluences=sellIsCounterTrend?COUNTERTREND_MIN_CONFLUENCES:TREND_MIN_CONFLUENCES

    // Armed route rules:
    // Trend BUY/SELL: original rejection plus new sweep/reclaim or displacement paths.
    // Counter BUY/SELL: completed sweep/reclaim or displacement-quality CHOCH.
    // EMA regime and VWAP remain additive ranking evidence.

    // Each fresh setup selects one exact entry-timeframe candle whose full
    // HIGH-to-LOW rectangle fits inside the corresponding HIGH RISK zone.
    [buyHighEntryLo,buyHighEntryHi,buyHighEntryTime]=f_select_full_entry_candle(buyHighLo,buyHighHi,close,true,readySideBuffer,entryHighs,entryLows,entryTimes)
    [sellHighEntryLo,sellHighEntryHi,sellHighEntryTime]=f_select_full_entry_candle(sellHighLo,sellHighHi,close,false,readySideBuffer,entryHighs,entryLows,entryTimes)

    bool buyHighCandidate=allowBuy and buyConfirmationValid and not na(buyHighEntryLo) and buyHighRetestValid and buyHighConfluences>=buyRequiredConfluences
    bool sellHighCandidate=allowSell and sellConfirmationValid and not na(sellHighEntryLo) and sellHighRetestValid and sellHighConfluences>=sellRequiredConfluences

    string bestDirection="NONE"
    string bestRisk=""
    string bestConfirmation=""
    bool bestCounterTrend=false
    bool bestMtfCluster=false
    bool bestSweepReclaim=false
    bool bestPremiumLiquidity=false
    bool bestDisplacementChoch=false
    bool bestEmaSlope=false
    bool bestEmaRegime=false
    bool bestVWAP=false
    int bestRequiredConfluences=0
    int bestConfluences=-1
    float bestZoneDistance=na
    float bestSupportLo=na
    float bestSupportHi=na
    int bestZoneRetests=0
    float bestEntryLo=na
    float bestEntryHi=na
    int bestEntryTime=na

    // Exclusive HIGH RISK selection:
    // 1) Highest confluence count between BUY HIGH and SELL HIGH.
    // 2) When counts tie, choose the eligible zone nearest live CMP.
    if buyHighCandidate
        float candidateDistance=math.abs((buyHighLo+buyHighHi)/2.0-close)
        bool candidateWins=buyHighConfluences>bestConfluences or (buyHighConfluences==bestConfluences and (na(bestZoneDistance) or candidateDistance<bestZoneDistance))
        if candidateWins
            bestDirection:="BUY"
            bestRisk:="HIGH RISK"
            bestConfirmation:=bullishConfirmationName
            bestCounterTrend:=buyIsCounterTrend
            bestMtfCluster:=buyHighMtfCluster
            bestSweepReclaim:=bullishAnySweepInBuyZone
            bestPremiumLiquidity:=bullishPremiumSweepInBuyZone
            bestDisplacementChoch:=bullishDisplacementInBuyZone
            bestEmaSlope:=buyEmaSlopeConfluence
            bestEmaRegime:=buyEmaRegimeConfluence
            bestVWAP:=buyVWAPConfluence
            bestRequiredConfluences:=buyRequiredConfluences
            bestConfluences:=buyHighConfluences
            bestZoneDistance:=candidateDistance
            bestSupportLo:=buyHighLo
            bestSupportHi:=buyHighHi
            bestZoneRetests:=buyHighRetests
            bestEntryLo:=buyHighEntryLo
            bestEntryHi:=buyHighEntryHi
            bestEntryTime:=buyHighEntryTime

    if sellHighCandidate
        float candidateDistance=math.abs((sellHighLo+sellHighHi)/2.0-close)
        bool candidateWins=sellHighConfluences>bestConfluences or (sellHighConfluences==bestConfluences and (na(bestZoneDistance) or candidateDistance<bestZoneDistance))
        if candidateWins
            bestDirection:="SELL"
            bestRisk:="HIGH RISK"
            bestConfirmation:=bearishConfirmationName
            bestCounterTrend:=sellIsCounterTrend
            bestMtfCluster:=sellHighMtfCluster
            bestSweepReclaim:=bearishAnySweepInSellZone
            bestPremiumLiquidity:=bearishPremiumSweepInSellZone
            bestDisplacementChoch:=bearishDisplacementInSellZone
            bestEmaSlope:=sellEmaSlopeConfluence
            bestEmaRegime:=sellEmaRegimeConfluence
            bestVWAP:=sellVWAPConfluence
            bestRequiredConfluences:=sellRequiredConfluences
            bestConfluences:=sellHighConfluences
            bestZoneDistance:=candidateDistance
            bestSupportLo:=sellHighLo
            bestSupportHi:=sellHighHi
            bestZoneRetests:=sellHighRetests
            bestEntryLo:=sellHighEntryLo
            bestEntryHi:=sellHighEntryHi
            bestEntryTime:=sellHighEntryTime

    bool selectedCandidate=bestDirection!="NONE" and not na(bestEntryLo) and not na(bestEntryHi) and bestEntryHi>bestEntryLo

    if selectedCandidate
        state:="ARMED"
        armedDirection:=bestDirection
        armedRisk:=bestRisk
        armedConfirmation:=bestConfirmation
        armedCounterTrend:=bestCounterTrend
        armedMtfCluster:=bestMtfCluster
        armedSweepReclaim:=bestSweepReclaim
        armedPremiumLiquidity:=bestPremiumLiquidity
        armedDisplacementChoch:=bestDisplacementChoch
        armedEmaSlope:=bestEmaSlope
        armedEmaRegime:=bestEmaRegime
        armedVWAP:=bestVWAP
        armedRequiredConfluences:=bestRequiredConfluences
        armedAtBar:=bar_index
        armedConfluences:=bestConfluences
        armedSupportLo:=bestSupportLo
        armedSupportHi:=bestSupportHi
        armedZoneRetests:=bestZoneRetests
        armedZoneExited:=false
        armedEntryLo:=bestEntryLo
        armedEntryHi:=bestEntryHi
        armedEntryTime:=bestEntryTime
        armedAtClock:=barstate.isrealtime?timenow:time_close
        armedSetupId:=bestDirection+"-"+str.tostring(bestEntryTime)+"-"+str.tostring(bar_index)
        armedTouchLatched:=false
        armedTouchPrice:=na
        armedEvent:=true

    // Reject invalid candidates instead of leaving a false READY state.
    if state=="ARMED" and not armedEvent
        state:="MONITORING"
        armedSetupId:=""
        armedDirection:="NONE"
        armedRisk:=""
        armedConfirmation:=""
        armedExtraReasons:=""
        armedCounterTrend:=false
        armedMtfCluster:=false
        armedSweepReclaim:=false
        armedPremiumLiquidity:=false
        armedDisplacementChoch:=false
        armedEmaSlope:=false
        armedEmaRegime:=false
        armedVWAP:=false
        armedRequiredConfluences:=TREND_MIN_CONFLUENCES
        armedAtClock:=na
        armedEntryLo:=na
        armedEntryHi:=na
        armedTouchLatched:=false
        armedTouchPrice:=na

// The supporting map can recalculate while READY is waiting.
// Synchronize the armed setup to the exact HIGH RISK box currently drawn,
// so a stale entry rectangle can never remain at an older zone.
// Every READY setup is synchronized exclusively to its direction's HIGH RISK zone.
float visibleArmedZoneLo=state=="ARMED"?(armedDirection=="BUY"?buyHighLo:sellHighLo):na
float visibleArmedZoneHi=state=="ARMED"?(armedDirection=="BUY"?buyHighHi:sellHighHi):na
int visibleArmedZoneTime=state=="ARMED"?(armedDirection=="BUY"?buyHighTime:sellHighTime):na
int visibleArmedConfluences=state=="ARMED"?(armedDirection=="BUY"?buyHighConfluences:sellHighConfluences):0
bool visibleArmedMtfCluster=state=="ARMED"?(armedDirection=="BUY"?buyHighMtfCluster:sellHighMtfCluster):false
bool visibleArmedSweepReclaim=state=="ARMED"?(armedDirection=="BUY"?bullishAnySweepInBuyZone:bearishAnySweepInSellZone):false
bool visibleArmedPremiumLiquidity=state=="ARMED"?(armedDirection=="BUY"?bullishPremiumSweepInBuyZone:bearishPremiumSweepInSellZone):false
bool visibleArmedDisplacementChoch=state=="ARMED"?(armedDirection=="BUY"?bullishDisplacementInBuyZone:bearishDisplacementInSellZone):false
bool visibleArmedEmaSlope=state=="ARMED"?(armedDirection=="BUY"?buyEmaSlopeConfluence:sellEmaSlopeConfluence):false
bool visibleArmedEmaRegime=state=="ARMED"?(armedDirection=="BUY"?buyEmaRegimeConfluence:sellEmaRegimeConfluence):false
bool visibleArmedVWAP=state=="ARMED"?(armedDirection=="BUY"?buyVWAPConfluence:sellVWAPConfluence):false
int visibleArmedRetests=state=="ARMED"?f_zone_retest_count(visibleArmedZoneLo,visibleArmedZoneHi,visibleArmedZoneTime,entryCandleTime,supportSeconds,entryHighs,entryLows,entryTimes):0

float zoneSyncTolerance=syminfo.mintick
bool visibleArmedZoneValid=state=="ARMED" and not na(visibleArmedZoneLo) and not na(visibleArmedZoneHi) and visibleArmedZoneHi>visibleArmedZoneLo
bool visibleArmedZoneChanged=visibleArmedZoneValid and (na(armedSupportLo) or na(armedSupportHi) or math.abs(visibleArmedZoneLo-armedSupportLo)>zoneSyncTolerance or math.abs(visibleArmedZoneHi-armedSupportHi)>zoneSyncTolerance)

if visibleArmedZoneChanged
    [syncedEntryLo,syncedEntryHi,syncedEntryTime]=f_select_full_entry_candle(visibleArmedZoneLo,visibleArmedZoneHi,close,armedDirection=="BUY",readySideBuffer,entryHighs,entryLows,entryTimes)
    bool syncedConfirmationValid=armedDirection=="BUY"?bullishArmedConfirmation:bearishArmedConfirmation
    bool syncedReversalValid=not armedCounterTrend or (armedDirection=="BUY"?(bullishDisplacementInBuyZone or bullishAnySweepInBuyZone):(bearishDisplacementInSellZone or bearishAnySweepInSellZone))
    string syncedConfirmation=armedDirection=="BUY"?bullishConfirmationName:bearishConfirmationName
    int syncedRequiredConfluences=armedCounterTrend?COUNTERTREND_MIN_CONFLUENCES:TREND_MIN_CONFLUENCES
    bool syncedRetestValid=visibleArmedRetests<=MAXIMUM_ZONE_RETESTS
    bool syncedCandidateValid=not na(syncedEntryLo) and not na(syncedEntryHi) and syncedEntryHi>syncedEntryLo and syncedConfirmationValid and syncedReversalValid and syncedRetestValid and visibleArmedConfluences>=syncedRequiredConfluences

    if syncedCandidateValid
        armedSupportLo:=visibleArmedZoneLo
        armedSupportHi:=visibleArmedZoneHi
        armedEntryLo:=syncedEntryLo
        armedEntryHi:=syncedEntryHi
        armedEntryTime:=syncedEntryTime
        armedConfluences:=visibleArmedConfluences
        armedMtfCluster:=visibleArmedMtfCluster
        armedSweepReclaim:=visibleArmedSweepReclaim
        armedPremiumLiquidity:=visibleArmedPremiumLiquidity
        armedDisplacementChoch:=visibleArmedDisplacementChoch
        armedEmaSlope:=visibleArmedEmaSlope
        armedEmaRegime:=visibleArmedEmaRegime
        armedVWAP:=visibleArmedVWAP
        armedRequiredConfluences:=syncedRequiredConfluences
        armedZoneRetests:=visibleArmedRetests
        armedZoneExited:=false
        armedConfirmation:=syncedConfirmation
        // Keep the original READY candle for LIVE eligibility.
        // Only the entry rectangle/map data is synchronized here.
        armedAtClock:=barstate.isrealtime?timenow:time_close
        armedSetupId:=armedDirection+"-"+str.tostring(syncedEntryTime)+"-"+str.tostring(bar_index)
        armedTouchLatched:=false
        armedTouchPrice:=na
        armedEvent:=true
    else
        // No valid full candle exists inside the currently drawn risk box.
        // Remove the stale READY signal and wait for a fresh valid setup.
        state:="MONITORING"
        armedSetupId:=""
        armedDirection:="NONE"
        armedRisk:=""
        armedConfirmation:=""
        armedExtraReasons:=""
        armedCounterTrend:=false
        armedMtfCluster:=false
        armedSweepReclaim:=false
        armedPremiumLiquidity:=false
        armedDisplacementChoch:=false
        armedEmaSlope:=false
        armedEmaRegime:=false
        armedVWAP:=false
        armedRequiredConfluences:=TREND_MIN_CONFLUENCES
        armedAtClock:=na
        armedZoneRetests:=0
        armedZoneExited:=false
        armedEntryLo:=na
        armedEntryHi:=na
        armedTouchLatched:=false
        armedTouchPrice:=na

if armedEvent
    float armedMid=(armedSupportLo+armedSupportHi)/2.0
    bool reasonBRN=f_near_round(armedMid,brnStep,confluenceTolerance)
    bool reasonMicro=not reasonBRN and f_near_round(armedMid,microBrnStep,confluenceTolerance)
    bool reasonEMA=f_near(armedMid,supportEMA,confluenceTolerance)
    bool reasonTrend=f_near(armedMid,armedDirection=="BUY"?supportTrendSupport:supportTrendResistance,confluenceTolerance)
    bool reasonFib=f_near(armedMid,armedDirection=="BUY"?buyFib50:sellFib50,confluenceTolerance) or f_near(armedMid,armedDirection=="BUY"?buyFib618:sellFib618,confluenceTolerance)

    // Freeze every available optional confluence for alerts and the trade card.
    armedExtraReasons:=""
    bool reasonCHOCH=(armedDirection=="BUY"?bullishRecentChoch:bearishRecentChoch) and not armedDisplacementChoch
    if reasonCHOCH
        armedExtraReasons:=armedExtraReasons+"\nCHOCH"
    if armedMtfCluster
        armedExtraReasons:=armedExtraReasons+"\nMTF LEVEL CLUSTER"
    if armedPremiumLiquidity
        string premiumType=armedDirection=="BUY"?lastBullishPremiumSweepType:lastBearishPremiumSweepType
        armedExtraReasons:=armedExtraReasons+"\n"+premiumType+" SWEEP + RECLAIM"
    else if armedSweepReclaim
        armedExtraReasons:=armedExtraReasons+"\nLIQUIDITY SWEEP + RECLAIM"
    if armedDisplacementChoch
        armedExtraReasons:=armedExtraReasons+"\nDISPLACEMENT CHOCH"
    if armedEmaSlope
        armedExtraReasons:=armedExtraReasons+"\nEMA13 SLOPE"
    if armedEmaRegime
        armedExtraReasons:=armedExtraReasons+"\nEMA13 / EMA50 REGIME"
    if armedVWAP
        armedExtraReasons:=armedExtraReasons+"\nDAILY VWAP"
    if reasonBRN
        armedExtraReasons:=armedExtraReasons+"\nBRN CONFLUENCE"
    if reasonMicro
        armedExtraReasons:=armedExtraReasons+"\nMICRO BRN CONFLUENCE"
    if reasonEMA
        armedExtraReasons:=armedExtraReasons+"\nEMA REJECTION"
    if reasonTrend
        armedExtraReasons:=armedExtraReasons+"\nTRENDLINE CONFLUENCE"
    if reasonFib
        armedExtraReasons:=armedExtraReasons+"\nFIBONACCI CONFLUENCE"

float invalidationBuffer=math.max(pipSize*5.0,syminfo.mintick*2.0)
int armedClock=barstate.isrealtime?timenow:time_close
bool armedExpired=state=="ARMED" and not na(armedAtClock) and armedClock-armedAtClock>armedExpiryEntryBars*entrySeconds*1000.0
bool trendRouteInvalid=state=="ARMED" and not armedCounterTrend and ((armedDirection=="BUY" and not trendBuyRoute) or (armedDirection=="SELL" and not trendSellRoute))

// Counter-trend READY setups are frozen. The zone, expiry and TP/SL rules manage them.
bool counterTrendRouteInvalid=false
bool biasInvalid=trendRouteInvalid or counterTrendRouteInvalid
bool zoneInvalid=state=="ARMED" and ((armedDirection=="BUY" and close<armedSupportLo-invalidationBuffer) or (armedDirection=="SELL" and close>armedSupportHi+invalidationBuffer))

bool armedSupportTouched=state=="ARMED" and f_overlap(low,high,armedSupportLo,armedSupportHi)
if state=="ARMED" and not armedSupportTouched
    armedZoneExited:=true

// If READY was created on the second retest, a later return is the third retest
// and invalidates the zone before a LIVE signal can start.
bool retestLimitInvalid=state=="ARMED" and armedZoneExited and armedSupportTouched and armedZoneRetests>=MAXIMUM_ZONE_RETESTS

// READY must remain pending on the correct side of CMP.
// A genuine touch has priority and must transition to LIVE instead of being invalidated.
bool armedEntryTouchedNow=state=="ARMED" and f_overlap(low,high,armedEntryLo,armedEntryHi)
bool entrySideInvalid=state=="ARMED" and not armedEntryTouchedNow and ((armedDirection=="BUY" and armedEntryHi>=close-readySideBuffer) or (armedDirection=="SELL" and armedEntryLo<=close+readySideBuffer))

// READY rectangle must remain completely inside the exact risk box
// currently drawn on the chart, not only the zone frozen at initial arming.
float liveRiskZoneLo=state=="ARMED"?(armedDirection=="BUY"?buyHighLo:sellHighLo):na
float liveRiskZoneHi=state=="ARMED"?(armedDirection=="BUY"?buyHighHi:sellHighHi):na
bool entryOutsideVisibleRiskZone=state=="ARMED" and (na(liveRiskZoneLo) or na(liveRiskZoneHi) or na(armedEntryLo) or na(armedEntryHi) or armedEntryLo<liveRiskZoneLo-zoneSyncTolerance or armedEntryHi>liveRiskZoneHi+zoneSyncTolerance)

// LIVE starts only from a completely later chart candle.
// The original READY candle is preserved even when the visible map synchronizes.
// Any later candle that actually overlaps the current frozen entry rectangle can trigger LIVE.
bool touchAfterArming=state=="ARMED" and not na(armedAtBar) and bar_index>armedAtBar
bool firstTouchNow=touchAfterArming and armedEntryTouchedNow and not armedTouchLatched

if firstTouchNow
    armedTouchLatched:=true
    armedTouchPrice:=f_touch_entry(armedEntryLo,armedEntryHi,close[1],open,close)

// Before the first touch, normal READY invalidation still applies.
// Once touched, the latched event has priority and cannot be erased by a later tick.
bool readyInvalidBeforeTouch=armedExpired or biasInvalid or zoneInvalid or retestLimitInvalid or entrySideInvalid or entryOutsideVisibleRiskZone
if state=="ARMED" and not armedTouchLatched and (readyInvalidBeforeTouch or not chartMatchesSelected)
    state:="MONITORING"
    armedSetupId:=""
    armedDirection:="NONE"
    armedRisk:=""
    armedConfirmation:=""
    armedExtraReasons:=""
    armedCounterTrend:=false
    armedMtfCluster:=false
    armedSweepReclaim:=false
    armedPremiumLiquidity:=false
    armedDisplacementChoch:=false
    armedEmaSlope:=false
    armedEmaRegime:=false
    armedVWAP:=false
    armedRequiredConfluences:=TREND_MIN_CONFLUENCES
    armedAtClock:=na
    armedZoneRetests:=0
    armedZoneExited:=false
    armedEntryLo:=na
    armedEntryHi:=na
    armedTouchLatched:=false
    armedTouchPrice:=na

bool entryTouched=state=="ARMED" and armedTouchLatched

// Entry price is frozen at the first actual touch and cannot move or disappear.
float plannedEntry=entryTouched?armedTouchPrice:na
float plannedSL=na
float plannedTP=na
float plannedRR=na
float snrBuffer=snrFrontRunPips*pipSize
float volatilityStopDistance=math.max(stopBufferPips*pipSize,nz(chartATR,targetMinimumDistance)*stopATRMultiplier)
float volatilityTargetDistance=nz(chartATR,targetMinimumDistance)*targetATRMultiplier

if entryTouched and chartMatchesSelected
    if armedDirection=="BUY"
        float baseSL=math.round_to_mintick(armedEntryLo-volatilityStopDistance)
        float freshSupport=f_nearest_below4(armedEntryLo-snrBuffer,S1,S2,supportSwingLow,supportTrendSupport)
        float protectedSL=not na(freshSupport)?math.round_to_mintick(freshSupport+snrBuffer):baseSL
        plannedSL:=math.max(baseSL,protectedSL)

        if plannedSL<plannedEntry
            float riskDistance=plannedEntry-plannedSL
            float desiredReward=f_clamp(math.max(volatilityTargetDistance,riskDistance*1.5),targetMinimumDistance,targetMaximumDistance)
            desiredReward:=math.min(desiredReward,riskDistance*maximumRR)
            float freshResistance=f_nearest_above4(plannedEntry,R1,R2,supportSwingHigh,supportTrendResistance)
            float availableReward=not na(freshResistance)?freshResistance-snrBuffer-plannedEntry:desiredReward
            float rewardDistance=math.min(desiredReward,availableReward)
            plannedTP:=rewardDistance>=riskDistance*minimumRR?math.round_to_mintick(plannedEntry+rewardDistance):na
            plannedRR:=not na(plannedTP)?(plannedTP-plannedEntry)/riskDistance:na

    if armedDirection=="SELL"
        float baseSL=math.round_to_mintick(armedEntryHi+volatilityStopDistance)
        float freshResistance=f_nearest_above4(armedEntryHi+snrBuffer,R1,R2,supportSwingHigh,supportTrendResistance)
        float protectedSL=not na(freshResistance)?math.round_to_mintick(freshResistance-snrBuffer):baseSL
        plannedSL:=math.min(baseSL,protectedSL)

        if plannedSL>plannedEntry
            float riskDistance=plannedSL-plannedEntry
            float desiredReward=f_clamp(math.max(volatilityTargetDistance,riskDistance*1.5),targetMinimumDistance,targetMaximumDistance)
            desiredReward:=math.min(desiredReward,riskDistance*maximumRR)
            float freshSupport=f_nearest_below4(plannedEntry,S1,S2,supportSwingLow,supportTrendSupport)
            float availableReward=not na(freshSupport)?plannedEntry-(freshSupport+snrBuffer):desiredReward
            float rewardDistance=math.min(desiredReward,availableReward)
            plannedTP:=rewardDistance>=riskDistance*minimumRR?math.round_to_mintick(plannedEntry-rewardDistance):na
            plannedRR:=not na(plannedTP)?(plannedEntry-plannedTP)/riskDistance:na

// A touched READY setup must always be released as LIVE.
// When the structure-based TP/SL plan is unavailable, build a bounded
// ATR/risk fallback instead of dropping the touch event.
bool primaryPlanValid=entryTouched and not na(plannedEntry) and not na(plannedSL) and not na(plannedTP) and not na(plannedRR) and plannedRR>=minimumRR and plannedRR<=maximumRR+0.0001

if entryTouched and not primaryPlanValid and not na(plannedEntry)
    float fallbackRisk=math.max(volatilityStopDistance,targetMinimumDistance/maximumRR)
    float fallbackRewardFloor=fallbackRisk*minimumRR
    float fallbackRewardCeiling=math.max(fallbackRewardFloor,math.min(targetMaximumDistance,fallbackRisk*maximumRR))
    float fallbackReward=f_clamp(math.max(volatilityTargetDistance,targetMinimumDistance),fallbackRewardFloor,fallbackRewardCeiling)

    if armedDirection=="BUY"
        plannedSL:=math.round_to_mintick(plannedEntry-fallbackRisk)
        plannedTP:=math.round_to_mintick(plannedEntry+fallbackReward)
        plannedRR:=fallbackReward/fallbackRisk
    else if armedDirection=="SELL"
        plannedSL:=math.round_to_mintick(plannedEntry+fallbackRisk)
        plannedTP:=math.round_to_mintick(plannedEntry-fallbackReward)
        plannedRR:=fallbackReward/fallbackRisk

bool validPlan=entryTouched and armedConfluences>=armedRequiredConfluences and not na(plannedEntry) and not na(plannedSL) and not na(plannedTP) and not na(plannedRR) and plannedRR>=minimumRR and plannedRR<=maximumRR+0.0001

// Commit LIVE only on the confirmed chart-timeframe close. The first touch is
// already stored by the varip latch, so the alert, marker and trade card all
// consume the same final immutable setup snapshot and cannot diverge after
// TradingView recalculates the candle.
if state=="ARMED" and validPlan and not liveTradeLocked and barstate.isconfirmed
    // Freeze the complete trade plan at the exact LIVE trigger.
    liveTradeLocked:=true
    activeSetupId:=armedSetupId
    activeDirection:=armedDirection
    activeRisk:=armedRisk
    activeConfirmation:=armedConfirmation
    activeExtraReasons:=armedExtraReasons
    activeCounterTrend:=armedCounterTrend
    activeConfluences:=armedConfluences
    activeEntry:=plannedEntry
    activeSL:=plannedSL
    activeTP:=plannedTP
    activeEntryLo:=armedEntryLo
    activeEntryHi:=armedEntryHi
    activeEntryTime:=armedEntryTime
    activeRR:=plannedRR
    activeStartBar:=bar_index
    activeStartTime:=time
    activeBreakEvenArmed:=false
    activeBreakEvenTriggerPips:=breakEvenTriggerPips
    activeBreakEvenTriggerPrice:=activeDirection=="BUY"?math.round_to_mintick(activeEntry+breakEvenTriggerDistance):math.round_to_mintick(activeEntry-breakEvenTriggerDistance)
    float markerOffset=math.max(nz(chartATR,targetMinimumDistance)*0.20,pipSize*10.0)
    activeMarkerPrice:=activeDirection=="BUY"?low-markerOffset:high+markerOffset

    // Historical reconstruction creates a permanent marker immediately. It is
    // visually identical to a normal BUY/SELL marker, while its tooltip states
    // that no realtime alert was possible for the historical execution.
    if not barstate.isrealtime and showBacktestMarkers and showMarkers and activeSetupId!="" and array.indexof(permanentMarkerSetupIds,activeSetupId)==-1
        string historicalMarkerStyle=activeDirection=="BUY"?label.style_label_up:label.style_label_down
        color historicalMarkerColor=activeDirection=="BUY"?buyColor:sellColor
        label historicalMarker=label.new(activeStartTime,activeMarkerPrice,activeDirection,xloc=xloc.bar_time,yloc=yloc.price,style=historicalMarkerStyle,color=historicalMarkerColor,textcolor=premiumTextColor,size=size.small,tooltip="HISTORICAL RECONSTRUCTION • NO ALERT • "+activeDirection)
        array.push(permanentMarkerSetupIds,activeSetupId)
        array.push(permanentMarkerLabels,historicalMarker)
        while array.size(permanentMarkerSetupIds)>MAX_HISTORICAL_MARKERS
            array.shift(permanentMarkerSetupIds)
            label oldestHistoricalMarker=array.shift(permanentMarkerLabels)
            label.delete(oldestHistoricalMarker)

    activeExit:=na
    activeResultPips:=na
    state:="ACTIVE"
    armedTouchLatched:=false
    armedTouchPrice:=na
    liveEvent:=true
    realtimeLiveEvent:=barstate.isrealtime

if state=="ACTIVE" and liveTradeLocked and (bar_index>activeStartBar or (barstate.isrealtime and not liveEvent))
    // The initial SL remains active until the favorable break-even threshold is reached.
    // Realtime uses the sequential live close after arming. Historical bars only allow
    // a BE exit from a bar after the one that armed BE, avoiding same-bar path assumptions.
    bool beWasArmed=activeBreakEvenArmed
    bool initialStopHit=activeDirection=="BUY"?(barstate.isrealtime?close<=activeSL:low<=activeSL):(barstate.isrealtime?close>=activeSL:high>=activeSL)
    bool targetHit=activeDirection=="BUY"?(barstate.isrealtime?close>=activeTP:high>=activeTP):(barstate.isrealtime?close<=activeTP:low<=activeTP)
    float favorablePrice=activeDirection=="BUY"?(barstate.isrealtime?close:high):(barstate.isrealtime?close:low)
    bool breakEvenActivationHit=useBreakEven and not beWasArmed and not na(activeBreakEvenTriggerPrice) and (activeDirection=="BUY"?favorablePrice>=activeBreakEvenTriggerPrice:favorablePrice<=activeBreakEvenTriggerPrice)
    bool breakEvenReturnHit=beWasArmed and (activeDirection=="BUY"?(barstate.isrealtime?close<=activeEntry:low<=activeEntry):(barstate.isrealtime?close>=activeEntry:high>=activeEntry))

    // Conservative historical ordering: initial SL before BE is checked first;
    // once BE was already armed, a return to entry is checked before TP.
    if not beWasArmed and initialStopHit
        activeExit:=activeSL
        activeResultPips:=activeDirection=="BUY"?(activeExit-activeEntry)/pipSize:(activeEntry-activeExit)/pipSize
        state:="SL HIT"
        int slResultClock=barstate.islast?timenow:time_close
        resultStartedAt:=slResultClock
        resultHideAt:=resultStartedAt+resultTTL
        resultCardStatus:="SL HIT"
        resultCardSetupId:=activeSetupId
        resultCardDirection:=activeDirection
        resultCardRisk:=activeRisk
        resultCardConfirmation:=activeConfirmation
        resultCardExtraReasons:=activeExtraReasons
        resultCardConfluences:=activeConfluences
        resultCardEntry:=activeEntry
        resultCardSL:=activeSL
        resultCardTP:=activeTP
        resultCardExit:=activeExit
        resultCardPips:=activeResultPips
        slEvent:=true

    else if beWasArmed and breakEvenReturnHit
        activeExit:=activeEntry
        activeResultPips:=0.0
        state:="BE HIT"
        int beResultClock=barstate.islast?timenow:time_close
        resultStartedAt:=beResultClock
        resultHideAt:=resultStartedAt+resultTTL
        resultCardStatus:="BE HIT"
        resultCardSetupId:=activeSetupId
        resultCardDirection:=activeDirection
        resultCardRisk:=activeRisk
        resultCardConfirmation:=activeConfirmation
        resultCardExtraReasons:=activeExtraReasons
        resultCardConfluences:=activeConfluences
        resultCardEntry:=activeEntry
        resultCardSL:=activeEntry
        resultCardTP:=activeTP
        resultCardExit:=activeExit
        resultCardPips:=activeResultPips
        beEvent:=true

    else if targetHit
        activeExit:=activeTP
        activeResultPips:=activeDirection=="BUY"?(activeExit-activeEntry)/pipSize:(activeEntry-activeExit)/pipSize
        state:="TP HIT"
        int tpResultClock=barstate.islast?timenow:time_close
        resultStartedAt:=tpResultClock
        resultHideAt:=resultStartedAt+resultTTL
        resultCardStatus:="TP HIT"
        resultCardSetupId:=activeSetupId
        resultCardDirection:=activeDirection
        resultCardRisk:=activeRisk
        resultCardConfirmation:=activeConfirmation
        resultCardExtraReasons:=activeExtraReasons
        resultCardConfluences:=activeConfluences
        resultCardEntry:=activeEntry
        resultCardSL:=activeBreakEvenArmed?activeEntry:activeSL
        resultCardTP:=activeTP
        resultCardExit:=activeExit
        resultCardPips:=activeResultPips
        tpEvent:=true

    else if breakEvenActivationHit
        activeBreakEvenArmed:=true

// The result card is independent from the mutable signal-engine state.
// TP/SL/BE remains visible until the first chart update at or after 10 seconds.
int resultClock=barstate.islast?timenow:time_close
bool resultCardActive=resultCardStatus!="NONE"
bool resultExpired=resultCardActive and (na(resultHideAt) or resultClock>=resultHideAt)
bool resultVisible=resultCardActive and not resultExpired

if resultCardActive and resultExpired
    // Completed trades never prepare a recovery setup.
    // Resume scanning only for a completely fresh HIGH RISK setup.
    state:="MONITORING"
    armedSetupId:=""
    armedDirection:="NONE"
    armedRisk:=""
    armedConfirmation:=""
    armedExtraReasons:=""
    armedCounterTrend:=false
    armedMtfCluster:=false
    armedSweepReclaim:=false
    armedPremiumLiquidity:=false
    armedDisplacementChoch:=false
    armedEmaSlope:=false
    armedEmaRegime:=false
    armedVWAP:=false
    armedRequiredConfluences:=TREND_MIN_CONFLUENCES
    armedAtBar:=na
    armedAtClock:=na
    armedConfluences:=0
    armedSupportLo:=na
    armedSupportHi:=na
    armedZoneRetests:=0
    armedZoneExited:=false
    armedEntryLo:=na
    armedEntryHi:=na
    armedEntryTime:=na
    armedTouchLatched:=false
    armedTouchPrice:=na

    liveTradeLocked:=false
    activeSetupId:=""
    activeDirection:="NONE"
    activeRisk:=""
    activeConfirmation:=""
    activeExtraReasons:=""
    activeCounterTrend:=false
    activeConfluences:=0
    activeEntry:=na
    activeSL:=na
    activeTP:=na
    activeEntryLo:=na
    activeEntryHi:=na
    activeEntryTime:=na
    activeExit:=na
    activeResultPips:=na
    activeRR:=na
    activeMarkerPrice:=na
    activeStartBar:=na
    activeStartTime:=na
    activeBreakEvenArmed:=false
    activeBreakEvenTriggerPips:=na
    activeBreakEvenTriggerPrice:=na
    resultStartedAt:=na
    resultHideAt:=na

if resultExpired
    resultCardStatus:="NONE"
    resultCardSetupId:=""
    resultCardDirection:="NONE"
    resultCardRisk:=""
    resultCardConfirmation:=""
    resultCardExtraReasons:=""
    resultCardConfluences:=0
    resultCardEntry:=na
    resultCardSL:=na
    resultCardTP:=na
    resultCardExit:=na
    resultCardPips:=na

//--------------------------------------------------------------------------------------------------
// Historical-to-realtime boundary reset
//--------------------------------------------------------------------------------------------------
// TradingView does not deliver alerts for historical executions. Clear any simulated
// historical READY/LIVE/result state on the final confirmed historical bar so the
// realtime alert engine starts from a clean state and never displays an unalerted trade.
if barstate.islastconfirmedhistory
    state:="MONITORING"
    armedSetupId:=""
    armedDirection:="NONE"
    armedRisk:=""
    armedConfirmation:=""
    armedExtraReasons:=""
    armedCounterTrend:=false
    armedMtfCluster:=false
    armedSweepReclaim:=false
    armedPremiumLiquidity:=false
    armedDisplacementChoch:=false
    armedEmaSlope:=false
    armedEmaRegime:=false
    armedVWAP:=false
    armedAtBar:=na
    armedAtClock:=na
    armedEntryLo:=na
    armedEntryHi:=na
    armedEntryTime:=na
    armedTouchLatched:=false
    armedTouchPrice:=na
    liveTradeLocked:=false
    activeSetupId:=""
    activeDirection:="NONE"
    activeRisk:=""
    activeConfirmation:=""
    activeExtraReasons:=""
    activeCounterTrend:=false
    activeConfluences:=0
    activeEntry:=na
    activeSL:=na
    activeTP:=na
    activeEntryLo:=na
    activeEntryHi:=na
    activeEntryTime:=na
    activeExit:=na
    activeResultPips:=na
    activeRR:=na
    activeMarkerPrice:=na
    activeStartBar:=na
    activeStartTime:=na
    activeBreakEvenArmed:=false
    activeBreakEvenTriggerPips:=na
    activeBreakEvenTriggerPrice:=na
    resultStartedAt:=na
    resultHideAt:=na
    resultCardStatus:="NONE"
    resultCardSetupId:=""
    resultCardDirection:="NONE"
    resultCardRisk:=""
    resultCardConfirmation:=""
    resultCardExtraReasons:=""
    resultCardConfluences:=0
    resultCardEntry:=na
    resultCardSL:=na
    resultCardTP:=na
    resultCardExit:=na
    resultCardPips:=na

//--------------------------------------------------------------------------------------------------
// Unified marker and alert events
//--------------------------------------------------------------------------------------------------
// The currently ACTIVE setup also displays BUY LIVE or SELL LIVE.
// This LIVE badge is transient. The permanent BUY/SELL marker is committed only
// after the matching realtime LIVE alert() call executes and remains after the trade ends.
if showMarkers and state=="ACTIVE" and activeDirection!="NONE" and not na(activeStartTime) and not na(activeMarkerPrice)
    string liveMarkerStyle=activeDirection=="BUY"?label.style_label_up:label.style_label_down
    string liveMarkerText=activeDirection=="BUY"?"BUY LIVE":"SELL LIVE"
    color liveMarkerColor=activeDirection=="BUY"?buyColor:sellColor

    if na(currentLiveSignalMarker)
        currentLiveSignalMarker:=label.new(activeStartTime,activeMarkerPrice,liveMarkerText,xloc=xloc.bar_time,yloc=yloc.price,style=liveMarkerStyle,color=liveMarkerColor,textcolor=premiumTextColor,size=size.small)
    else
        label.set_xy(currentLiveSignalMarker,activeStartTime,activeMarkerPrice)
        label.set_text(currentLiveSignalMarker,liveMarkerText)
        label.set_style(currentLiveSignalMarker,liveMarkerStyle)
        label.set_color(currentLiveSignalMarker,liveMarkerColor)
        label.set_textcolor(currentLiveSignalMarker,premiumTextColor)
else
    if not na(currentLiveSignalMarker)
        label.delete(currentLiveSignalMarker)
        currentLiveSignalMarker:=na

// Permanent marker labels are created only at the LIVE commitment point. They are
// not deleted and rebuilt on each realtime update, preventing flicker or disappearance.

// Dynamic alerts and chart objects consume the same confirmed immutable event snapshot.
// alert.freq_all is paired with setup/state keys, so each event is delivered once
// without suppressing another event that happens in the same chart bar.
if enableAlerts and armedEvent and barstate.isrealtime and alertArmed
    string readyAlertKey=armedSetupId+"|READY"
    if readyAlertKey!=lastReadyAlertKey
        string readyMessage="🟡 "+armedDirection+" • SETUP READY\n\n"+syminfo.ticker+" • "+mode+" • "+entryTfLabel+"\n\nENTRY ZONE: "+f_zone(armedEntryLo,armedEntryHi)+"\nCONFIRMATION: "+str.upper(armedConfirmation)+"\n━━━━━━━━━━━━━━━━\n⏳ WAITING FOR ACTIVATION\n\nEZYMAP • SCALP MASTERY"
        alert(readyMessage,alert.freq_all)
        lastReadyAlertKey:=readyAlertKey

if enableAlerts and realtimeLiveEvent and alertLive
    string liveAlertKey=activeSetupId+"|LIVE"
    if liveAlertKey!=lastLiveAlertKey
        string activeEmoji=activeDirection=="BUY"?"🟢":"🔴"
        string counterTrendLine=activeCounterTrend?"\n⚠️ COUNTER-TREND TRADE":""
        string activeMessage=activeEmoji+" "+activeDirection+" • TRADE ACTIVE\n\n"+syminfo.ticker+" • "+mode+" • "+entryTfLabel+"\n\nENTRY: "+f_price(activeEntry)+"\nTAKE PROFIT: "+f_price(activeTP)+"\nSTOP LOSS: "+f_price(activeSL)+"\n\nCONFLUENCES: "+str.tostring(activeConfluences)+"\n━━━━━━━━━━━━━━━\n⚡️ POSITION ACTIVE"+counterTrendLine+"\n\nEZYMAP • SCALP MASTERY"
        alert(activeMessage,alert.freq_all)
        lastLiveAlertKey:=liveAlertKey

        // Atomic marker commit: create the permanent BUY/SELL marker only after
        // the matching realtime alert() call above executes.
        if showMarkers and activeSetupId!="" and array.indexof(permanentMarkerSetupIds,activeSetupId)==-1
            string syncedMarkerStyle=activeDirection=="BUY"?label.style_label_up:label.style_label_down
            color syncedMarkerColor=activeDirection=="BUY"?buyColor:sellColor
            label syncedMarker=label.new(activeStartTime,activeMarkerPrice,activeDirection,xloc=xloc.bar_time,yloc=yloc.price,style=syncedMarkerStyle,color=syncedMarkerColor,textcolor=premiumTextColor,size=size.small,tooltip="ALERT-SYNCED • "+activeDirection)
            array.push(permanentMarkerSetupIds,activeSetupId)
            array.push(permanentMarkerLabels,syncedMarker)
            while array.size(permanentMarkerSetupIds)>MAX_HISTORICAL_MARKERS
                array.shift(permanentMarkerSetupIds)
                label oldestSyncedMarker=array.shift(permanentMarkerLabels)
                label.delete(oldestSyncedMarker)

if enableAlerts and barstate.isrealtime and (tpEvent or slEvent or beEvent) and alertResult
    string resultAlertKey=resultCardSetupId+"|"+resultCardStatus
    if resultAlertKey!=lastResultAlertKey
        string resultMessage=tpEvent?"✅ COLLECT PROFIT\n\n"+syminfo.ticker+" • "+resultCardDirection+" • "+entryTfLabel+"\n\nRESULT\n"+f_signed(resultCardPips)+"\n\nEZYMAP • SCALP MASTERY":slEvent?"❌ HIT RISK\n\n"+syminfo.ticker+" • "+resultCardDirection+" • "+entryTfLabel+"\n\nRESULT\n"+f_signed(resultCardPips)+"\n\nEZYMAP • SCALP MASTERY":"⚪ BREAK EVEN\n\n"+syminfo.ticker+" • "+resultCardDirection+" • "+entryTfLabel+"\n\nRESULT\n0 PIPS\n\nEZYMAP • SCALP MASTERY"
        alert(resultMessage,alert.freq_all)
        lastResultAlertKey:=resultAlertKey

alertcondition(armedEvent and barstate.isrealtime,"EzyMap Gold BTC READY","EzyMap Gold BTC setup ready")
alertcondition(realtimeLiveEvent,"EzyMap Gold BTC LIVE","EzyMap Gold BTC live setup released")
alertcondition(tpEvent and barstate.isrealtime,"EzyMap Gold BTC TP","EzyMap Gold BTC take profit hit")
alertcondition(slEvent and barstate.isrealtime,"EzyMap Gold BTC SL","EzyMap Gold BTC stop loss hit")
alertcondition(beEvent and barstate.isrealtime,"EzyMap Gold BTC BE","EzyMap Gold BTC break-even hit")

//--------------------------------------------------------------------------------------------------
// Drawings
//--------------------------------------------------------------------------------------------------
var line s1Line=na
var line s2Line=na
var line r1Line=na
var line r2Line=na
var label s1Label=na
var label s2Label=na
var label r1Label=na
var label r2Label=na
var box buyHighBox=na
var box buyLowBox=na
var box sellHighBox=na
var box sellLowBox=na
var box armedEntryBox=na

int mapLeft=time-24*60*60*1000

if barstate.islast
    if showDirectionLevels
        if na(s1Line)
            s1Line:=line.new(mapLeft,S1,time,S1,xloc=xloc.bar_time,extend=extend.right,color=supportColor,width=2)
            s2Line:=line.new(mapLeft,S2,time,S2,xloc=xloc.bar_time,extend=extend.right,color=color.new(supportColor,25),width=1)
            r1Line:=line.new(mapLeft,R1,time,R1,xloc=xloc.bar_time,extend=extend.right,color=resistanceColor,width=2)
            r2Line:=line.new(mapLeft,R2,time,R2,xloc=xloc.bar_time,extend=extend.right,color=color.new(resistanceColor,25),width=1)
        line.set_xy1(s1Line,mapLeft,S1)
        line.set_xy2(s1Line,time,S1)
        line.set_xy1(s2Line,mapLeft,S2)
        line.set_xy2(s2Line,time,S2)
        line.set_xy1(r1Line,mapLeft,R1)
        line.set_xy2(r1Line,time,R1)
        line.set_xy1(r2Line,mapLeft,R2)
        line.set_xy2(r2Line,time,R2)

        if na(s1Label)
            s1Label:=label.new(time,S1,"S1",xloc=xloc.bar_time,yloc=yloc.price,style=label.style_label_left,color=supportColor,textcolor=color.black,size=size.small)
            s2Label:=label.new(time,S2,"S2",xloc=xloc.bar_time,yloc=yloc.price,style=label.style_label_left,color=color.new(supportColor,25),textcolor=color.black,size=size.small)
            r1Label:=label.new(time,R1,"R1",xloc=xloc.bar_time,yloc=yloc.price,style=label.style_label_left,color=resistanceColor,textcolor=color.black,size=size.small)
            r2Label:=label.new(time,R2,"R2",xloc=xloc.bar_time,yloc=yloc.price,style=label.style_label_left,color=color.new(resistanceColor,25),textcolor=color.black,size=size.small)

        label.set_xy(s1Label,time,S1)
        label.set_text(s1Label,"S1 - "+f_price(S1))
        label.set_xy(s2Label,time,S2)
        label.set_text(s2Label,"S2 - "+f_price(S2))
        label.set_xy(r1Label,time,R1)
        label.set_text(r1Label,"R1 - "+f_price(R1))
        label.set_xy(r2Label,time,R2)
        label.set_text(r2Label,"R2 - "+f_price(R2))
    else
        if not na(s1Line)
            line.delete(s1Line)
            line.delete(s2Line)
            line.delete(r1Line)
            line.delete(r2Line)
            s1Line:=na
            s2Line:=na
            r1Line:=na
            r2Line:=na
        if not na(s1Label)
            label.delete(s1Label)
            label.delete(s2Label)
            label.delete(r1Label)
            label.delete(r2Label)
            s1Label:=na
            s2Label:=na
            r1Label:=na
            r2Label:=na

    if showSupportingZones
        if na(buyHighBox)
            buyHighBox:=box.new(mapLeft,buyHighHi,time,buyHighLo,xloc=xloc.bar_time,extend=extend.right,bgcolor=color.new(supportColor,82),border_color=color.new(supportColor,20),border_width=2,text="BUY ZONE - HIGH RISK",text_color=color.black,text_size=size.small,text_halign=text.align_left)
            buyLowBox:=box.new(mapLeft,buyLowHi,time,buyLowLo,xloc=xloc.bar_time,extend=extend.right,bgcolor=color.new(supportColor,68),border_color=supportColor,border_width=3,text="BUY ZONE - LOW RISK",text_color=color.black,text_size=size.small,text_halign=text.align_left)
            sellHighBox:=box.new(mapLeft,sellHighHi,time,sellHighLo,xloc=xloc.bar_time,extend=extend.right,bgcolor=color.new(resistanceColor,82),border_color=color.new(resistanceColor,20),border_width=2,text="SELL ZONE - HIGH RISK",text_color=color.black,text_size=size.small,text_halign=text.align_left)
            sellLowBox:=box.new(mapLeft,sellLowHi,time,sellLowLo,xloc=xloc.bar_time,extend=extend.right,bgcolor=color.new(resistanceColor,68),border_color=resistanceColor,border_width=3,text="SELL ZONE - LOW RISK",text_color=color.black,text_size=size.small,text_halign=text.align_left)

        box.set_lefttop(buyHighBox,mapLeft,buyHighHi)
        box.set_rightbottom(buyHighBox,time,buyHighLo)
        box.set_lefttop(buyLowBox,mapLeft,buyLowHi)
        box.set_rightbottom(buyLowBox,time,buyLowLo)
        box.set_lefttop(sellHighBox,mapLeft,sellHighHi)
        box.set_rightbottom(sellHighBox,time,sellHighLo)
        box.set_lefttop(sellLowBox,mapLeft,sellLowHi)
        box.set_rightbottom(sellLowBox,time,sellLowLo)
    else
        if not na(buyHighBox)
            box.delete(buyHighBox)
            box.delete(buyLowBox)
            box.delete(sellHighBox)
            box.delete(sellLowBox)
            buyHighBox:=na
            buyLowBox:=na
            sellHighBox:=na
            sellLowBox:=na

    bool showingLockedTrade=state=="ACTIVE" or resultVisible
    bool entryZoneVisible=showEntryZone and (state=="ARMED" or showingLockedTrade)
    if entryZoneVisible
        string entryBoxDirection=showingLockedTrade?activeDirection:armedDirection
        string entryBoxRisk=showingLockedTrade?activeRisk:armedRisk
        float entryBoxLo=showingLockedTrade?activeEntryLo:armedEntryLo
        float entryBoxHi=showingLockedTrade?activeEntryHi:armedEntryHi
        int entryBoxTime=showingLockedTrade?activeEntryTime:armedEntryTime

        if na(armedEntryBox)
            color entryColor=entryBoxDirection=="BUY"?buyColor:sellColor
            armedEntryBox:=box.new(nz(entryBoxTime,time),entryBoxHi,time,entryBoxLo,xloc=xloc.bar_time,extend=extend.right,bgcolor=color.new(entryColor,55),border_color=entryColor,border_width=3,text=entryBoxDirection+" ENTRY ZONE • "+entryBoxRisk,text_color=color.black,text_size=size.small,text_halign=text.align_left)

        box.set_lefttop(armedEntryBox,nz(entryBoxTime,time),entryBoxHi)
        box.set_rightbottom(armedEntryBox,time,entryBoxLo)
        box.set_text(armedEntryBox,entryBoxDirection+" ENTRY ZONE • "+entryBoxRisk)
    else
        if not na(armedEntryBox)
            box.delete(armedEntryBox)
            armedEntryBox:=na

//--------------------------------------------------------------------------------------------------
// Dashboard and live trade card
//--------------------------------------------------------------------------------------------------
bool marketOpen=barstate.isrealtime
string dashboardMode=mode
string dashboardBias=marketOpen?biasText:"CLOSED"
string dashboardStatus=state=="ACTIVE"?"LIVE "+activeDirection+(activeBreakEvenArmed?" • BE ARMED":"")+" SIGNAL":state=="ARMED"?"READY "+armedDirection+" SIGNAL":"WAIT"

var table dashboard=table.new(position.bottom_right,2,3,bgcolor=panelColor,frame_color=premiumFrameColor,frame_width=1,border_color=color.new(premiumFrameColor,62),border_width=1)
var table tradeCard=table.new(position.top_right,2,8,bgcolor=panelColor,frame_color=premiumFrameColor,frame_width=1,border_color=color.new(premiumFrameColor,62),border_width=1)

if barstate.islast
    table.clear(dashboard,0,0,1,2)
    table.clear(tradeCard,0,0,1,7)

    if showDashboard
        table.cell(dashboard,0,0,"MODE",bgcolor=headerColor,text_color=neutralColor,text_size=size.small)
        table.cell(dashboard,1,0,dashboardMode,bgcolor=headerColor,text_color=premiumTextColor,text_size=size.small,text_halign=text.align_right)
        table.cell(dashboard,0,1,"BIAS",text_color=neutralColor,text_size=size.small)
        table.cell(dashboard,1,1,dashboardBias,text_color=bullishBias?buyColor:bearishBias?sellColor:warningColor,text_size=size.small,text_halign=text.align_right)
        table.cell(dashboard,0,2,"STATUS",text_color=neutralColor,text_size=size.small)
        table.cell(dashboard,1,2,dashboardStatus,text_color=state=="ACTIVE"?activeDirection=="BUY"?buyColor:sellColor:state=="ARMED"?warningColor:neutralColor,text_size=size.small,text_halign=text.align_right)

    bool cardVisible=showTradeCard and (state=="ACTIVE" or resultVisible)
    if cardVisible
        bool showingResult=resultVisible
        string cardDirection=showingResult?resultCardDirection:activeDirection
        string cardTitle=showingResult?resultCardStatus:"LIVE "+activeDirection+" SIGNAL"
        color cardHeader=showingResult?(resultCardStatus=="TP HIT"?buyColor:resultCardStatus=="BE HIT"?warningColor:sellColor):(activeDirection=="BUY"?buyColor:sellColor)
        float cardEntry=showingResult?resultCardEntry:activeEntry
        float cardTP=showingResult?resultCardTP:activeTP
        float cardSL=showingResult?resultCardSL:(activeBreakEvenArmed?activeEntry:activeSL)
        int cardConfluences=showingResult?resultCardConfluences:activeConfluences
        string cardRisk=showingResult?resultCardRisk:activeRisk
        string cardConfirmation=showingResult?resultCardConfirmation:activeConfirmation
        string cardExtraReasons=showingResult?resultCardExtraReasons:activeExtraReasons
        float tracked=showingResult?resultCardExit:close
        float liveMove=cardDirection=="BUY"?tracked-cardEntry:cardEntry-tracked
        float livePips=showingResult?resultCardPips:liveMove/pipSize
        string reasons=cardRisk+" ZONE\n"+str.upper(cardConfirmation)+cardExtraReasons+(not showingResult and activeBreakEvenArmed?"\nBREAK-EVEN ARMED +"+str.tostring(activeBreakEvenTriggerPips,"#")+" PIPS":"")

        string confidenceText=f_confidence_label(cardConfluences)
        color confidenceColor=cardConfluences>=4?buyColor:cardConfluences>=3?color.white:warningColor

        table.cell(tradeCard,0,0,cardTitle,bgcolor=cardHeader,text_color=premiumTextColor,text_size=size.small,text_halign=text.align_center)
        table.cell(tradeCard,0,1,"MODE",text_color=neutralColor,text_size=size.small)
        table.cell(tradeCard,1,1,mode+" • "+entryTfLabel,text_color=premiumTextColor,text_size=size.small,text_halign=text.align_right)
        table.cell(tradeCard,0,2,"CONFIDENCE",text_color=neutralColor,text_size=size.small)
        table.cell(tradeCard,1,2,confidenceText,text_color=confidenceColor,text_size=size.small,text_halign=text.align_right)
        table.cell(tradeCard,0,3,"ENTRY",text_color=neutralColor,text_size=size.small)
        table.cell(tradeCard,1,3,f_price(cardEntry),text_color=premiumTextColor,text_size=size.small,text_halign=text.align_right)
        table.cell(tradeCard,0,4,"TP",text_color=neutralColor,text_size=size.small)
        table.cell(tradeCard,1,4,f_price(cardTP),text_color=buyColor,text_size=size.small,text_halign=text.align_right)
        table.cell(tradeCard,0,5,"SL",text_color=neutralColor,text_size=size.small)
        table.cell(tradeCard,1,5,f_price(cardSL),text_color=sellColor,text_size=size.small,text_halign=text.align_right)
        table.cell(tradeCard,0,6,"P/L",text_color=neutralColor,text_size=size.small)
        table.cell(tradeCard,1,6,f_signed(livePips),text_color=livePips>=0?buyColor:sellColor,text_size=size.small,text_halign=text.align_right)
        table.cell(tradeCard,0,7,"WHY THIS TRADE",text_color=neutralColor,text_size=size.small)
        table.cell(tradeCard,1,7,reasons,text_color=premiumTextColor,text_size=size.small,text_halign=text.align_left)
